// IronSurf shell UI — single component, all state driven from Rust.
//
// The Rust side (src/app.rs) owns the real state (tabs, containers, IPC);
// this file renders snapshots pushed through `in` properties and forwards
// user intents through `out` callbacks. Keyboard chords are decided in
// Rust (see `keymap::shortcut_for`), so this file stays dumb.
//
// Note: Slint ids are only visible to descendants, and built-in elements
// cannot declare custom properties — so the two focus() watchers live in
// the small custom components `UrlBar` and `PageSurface` instead.

import { LineEdit, ListView, CheckBox, Slider } from "std-widgets.slint";

export struct TabInfo {
    id: int,
    title: string,
    color: color,
    active: bool,
    /// Digit of the tab-switch chord that reaches this tab today ("1" … "9";
    /// empty when no chord does) — Alt on Linux/Windows, ⌘ on macOS. Rust
    /// recomputes it from the live tab order, so the badge always shows where
    /// Alt-1 … Alt-9 (⌘1 … ⌘9) land right now.
    shortcut: string,
}

export struct ContainerInfo {
    name: string,
    color: color,
    isDefault: bool,
    /// The container's chosen proxy definition name ("" = direct); set by
    /// Rust from the registry so the manager rows say which container rides
    /// which proxy (task: proxies).
    proxy: string,
    /// The container's **private browsing** flag (task: private browsing);
    /// Rust reads it from the registry, so the manager's Private checkbox
    /// mirrors the stored state.
    private: bool,
}

/// One URL-bar autocomplete candidate (task: URL bar autocomplete): a
/// *filtered, ranked* subset of the visit log for what the user has typed so
/// far (`title` falls back to the URL in Rust, so a row always reads as
/// something). The browsing-history list itself is a page —
/// `ironsurf://history` — not a row model of this UI.
export struct SuggestItem {
    title: string,
    url: string,
}

/// One ⬇ download row (task: file downloads), reduced from the active tab's
/// store by `Core::download_rows`: newest first. `name` is what the file is
/// called, `status` says how far it came (`Saving 1.2 MB` / `Done 3 MB` /
/// `Failed`), and `sub` is the secondary line — the full path once the file
/// is on disk, until then how much has landed and where from.
export struct DownloadItem {
    name: string,
    status: string,
    sub: string,
}

/// One context-menu row (labels only; Rust keeps the matching actions and
/// maps the picked index back onto them).
export struct MenuItem {
    label: string,
}

/// One DevTools console row, already reduced by `state::TabState::console_rows`
/// (`level` drives the icon/colour, `text` is `"[source] message"`).
/// `selected` is the copy highlight: the row one click marked, which is what
/// `Copy` copies.
export struct ConsoleRow {
    level: string,
    text: string,
    selected: bool,
}

/// One DevTools network row: pre-formatted columns (`—` for values the engine
/// never sent); `failed` paints the status cell red with the error text in it.
/// `initiator` is what triggered the request (document / script / resource /
/// xhr / fetch).
export struct NetRow {
    method: string,
    url: string,
    initiator: string,
    status: string,
    size: string,
    time: string,
    failed: bool,
    /// The copy highlight, as on a console row: what `Copy` copies.
    selected: bool,
}

/// One syntax-highlighted token of the DevTools Inspector tree: `kind` is a
/// `state::TOK_*` value and `inspect-kind-color` below is the colour table —
/// a row is a list of these, never a pre-formatted string.
export struct Tok {
    text: string,
    kind: int,
}

/// One Inspector tree row. `node` is the snapshot's node id (a click reports it
/// back for `ToTab::InspectSelect`), `depth × 12px` is the indent, `twisty` is
/// `+` / `−` (`""` on a leaf, which is therefore not clickable), `toks` the
/// markup, `selected` the highlight and `italic` comments and the doctype.
export struct InspectRow {
    node: int,
    depth: int,
    twisty: string,
    toks: [Tok],
    selected: bool,
    italic: bool,
}

/// One breadcrumb crumb: the node id plus its name split the way the tree
/// splits it (`div` + `#main`), so `div#main` is not one flat label.
export struct CrumbItem {
    node: int,
    tag: string,
    ident: string,
}

/// One userscript-menu row, reduced from a stored `Userscript` by
/// `userscripts::userscript_rows` (`patterns` is the URL-pattern list joined
/// by `", "`, painted dim under the name; `enabled` drives the CheckBox).
export struct UserscriptRow {
    id: int,
    name: string,
    patterns: string,
    enabled: bool,
}

/// One User-Agent-menu row, reduced from the active tab's container value by
/// `user_agents::ua_menu_rows` (`ua` is the wire string — empty on the
/// "Default (IronSurf)" row; `active` marks the row matching the container).
export struct UaRow {
    label: string,
    ua: string,
    active: bool,
}

/// One proxy-menu row (task: proxies), built by Rust: row 0 is always
/// "Direct" (`url == ""`, never deletable), then one row per global
/// definition from the settings (`name — url`; `active` marks the row the
/// menu's container currently rides).
export struct ProxyRow {
    name: string,
    url: string,
    active: bool,
}

/// Crosshair icon for the Inspector's ⌖ picker button. The Unicode ⌖ exists
/// only in some fonts (macOS renders tofu), so the icon is two rectangles —
/// the same everywhere.
component Crosshair inherits Rectangle {
    in property <color> tint: #e8e8e8;
    Rectangle {
        x: root.width / 2 - 1px;
        y: 0px;
        width: 2px;
        height: root.height;
        background: root.tint;
    }
    Rectangle {
        x: 2px;
        y: root.height / 2 - 1px;
        width: root.width - 4px;
        height: 2px;
        background: root.tint;
    }
}

/// Hamburger icon (the history ☰ button and its menu header). U+2630 exists
/// only in some fonts (macOS renders tofu), so the icon is three rectangles —
/// the same everywhere.
component Hamburger inherits Rectangle {
    in property <color> tint: #e8e8e8;
    Rectangle { x: 2px; y: root.height / 2 - 5px; width: root.width - 4px; height: 2px; background: root.tint; }
    Rectangle { x: 2px; y: root.height / 2 - 1px; width: root.width - 4px; height: 2px; background: root.tint; }
    Rectangle { x: 2px; y: root.height / 2 + 3px; width: root.width - 4px; height: 2px; background: root.tint; }
}

/// A tiny borderless toolbar button (cheaper than styled Buttons in rows).
component MiniButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> enabled: true;
    /// Held-in look for toggle-style buttons (reader view's 📄): the button
    /// stays dark-blue while the mode it toggles is on.
    in property <bool> checked: false;
    in property <color> tint: #262626;
    /// Draw an icon instead of the text label: "crosshair" is the Inspector
    /// picker's ⌖, "hamburger" is the history ☰ — both glyphs miss on some
    /// fonts, so both icons are drawn rectangles that render everywhere.
    in property <string> icon: "";
    /// Words worth showing while the pointer rests on this button (task: popup
    /// blocker tooltip). Empty — every button but ⛔ today — and the button
    /// never says anything. Only the *hover* is reported: the text stays the
    /// owner's, so a control whose meaning changes under a pointer that never
    /// moved (⛔ clicked while hovered) restates itself instead of freezing on
    /// the words it had when the pointer arrived.
    in property <string> tip: "";
    callback clicked();
    /// The pointer came to a button that has something to say / left it again.
    callback tip-entered();
    callback tip-exited();
    width: Math.max(22px, root.icon == "" ? lbl.preferred-width + 12px : 0px);
    height: 24px;
    bg := Rectangle {
        background: ta.has-hover ? (root.enabled ? #3d3d3d : #2c2c2c) : (root.checked ? #35567d : root.tint);
        border-radius: 4px;
    }
    lbl := Text {
        text: root.label;
        visible: root.icon == "";
        color: root.enabled ? #e8e8e8 : #6a6a6a;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
    cross-ico := Crosshair {
        visible: root.icon == "crosshair";
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 14px;
        tint: root.enabled ? #e8e8e8 : #6a6a6a;
    }
    menu-ico := Hamburger {
        visible: root.icon == "hamburger";
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 14px;
        tint: root.enabled ? #e8e8e8 : #6a6a6a;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        // A tooltip follows the pointer, not the click: it arrives when the
        // pointer comes to rest over a button that has something to say and is
        // put away when the pointer goes (out of the button or out of the
        // window), and a move *across* the button repeats neither half.
        changed has-hover => {
            if (ta.has-hover && root.tip != "") {
                root.tip-entered();
            }
            if (!ta.has-hover) {
                root.tip-exited();
            }
        }
    }
}

/// Scrolls the Inspector tree to the row the **page** selected (⌖ pick, right-click
/// → *Inspect Element*). A built-in element — here, the tree's `ListView` — cannot
/// declare properties, functions or change callbacks of its own, so this watcher
/// sits beside the tree, is handed its geometry, and writes the scroll offset back.
///
/// The move is the smallest one that shows the row: a row already on screen does
/// not move at all, one below the fold lands at the bottom edge, one above it at
/// the top edge, and the pan never runs past either end of the tree. Because a
/// `ListView` can only be scrolled as far as it has realized its rows, one write
/// is not always enough — see the retry on `shown-from` below.
component InspectorReveal inherits Rectangle {
    /// The row to reveal (`-1` = the page owes nothing). Not called `row`: that
    /// name belongs to the layout system.
    in property <int> reveal-row: -1;
    /// Counts reveal requests: the row alone is not enough, because the page can
    /// select the same node twice and the tree has to move both times.
    in property <int> token: 0;
    /// The tree's row height (the height of its delegate).
    in property <length> row-height: 22px;
    /// How much tree is on screen, how tall all of it is, and how far it is
    /// scrolled at the moment (a positive number of pixels from its top).
    in property <length> window-height: 0px;
    in property <length> content-height: 0px;
    in property <length> shown-from: 0px;
    /// Where the page asked for the top of the tree, or negative once the reveal
    /// is over — which is also the point at which the tree belongs to the reader.
    in-out property <length> goal: -1px;
    /// How many turns of the ask a reveal may still take, how many times it may
    /// insist on an offset the tree has already been told, and that offset — see
    /// the note where they are used.
    in-out property <int> turns: 0;
    in-out property <int> insist: 0;
    in-out property <length> hold: -1px;
    in-out property <int> hold-turns: 0;
    /// The new `viewport-y` of the tree.
    callback scrolled(offset: length);
    /// Where the tree ended up (a positive number of pixels from its top), every
    /// time it moves — including when it was snapped short of what was asked. The
    /// pane mirrors this out so the shell can tell whether a reveal was honoured.
    callback observed(offset: length);

    pure function clamp(v: length, lo: length, hi: length) -> length {
        return Math.max(lo, Math.min(v, hi));
    }

    // The smallest move that shows the row from where the tree stands: land its
    // bottom on the bottom edge, or its top on the top edge when that is nearer,
    // and do not move at all when it is already on screen.
    function show-from-here() -> length {
        let row-top = reveal-row * row-height;
        let row-bottom = row-top + row-height;
        return row-bottom > shown-from + window-height ? row-bottom - window-height
                 : row-top < shown-from ? row-top
                 : shown-from;
    }

    function ask() {
        // Nothing owed, and no size to place a row in yet (a `ListView` is
        // measured on the first draw): an offset worked out now would be wrong.
        if (goal < 0px || window-height <= 0px) {
            return;
        }
        let last = Math.max(0px, content-height - window-height);
        // The pan goes in strides, and every position the tree reaches is another
        // turn of the ask — see the note on the turns below.
        let stride = Math.max(row-height, window-height * 0.5);
        let to = clamp(clamp(goal, shown-from - stride, shown-from + stride), 0px, last);
        turns -= 1;
        if (to == shown-from) {
            // There it is — or there was nowhere further to go. Either way the
            // tree goes back to the reader, and nothing moves unasked after this.
            goal = -1px;
        } else {
            scrolled(-to);
        }
    }

    changed token => {
        if (reveal-row >= 0 && window-height > 0px) {
            goal = show-from-here();
            turns = 8;
            insist = 4;
            ask();
        }
    }

    // A `ListView` can only be scrolled as far as it has *realized*, and it says
    // so by putting the offset back: a long ask snaps short of the row, and the
    // rows the tree realized on the way make the next ask reach further. So every
    // position the tree reports — including one it was snapped back to — is
    // another turn of the ask, and a reveal that cannot land runs out of turns
    // instead of pushing forever.
    //
    // Even an offset the tree accepted is not always kept: the first layout after
    // a long pan often puts the tree back a row or two short, because that layout
    // is what tells the tree how far it can go. So a finished reveal leaves a
    // `hold` — the offset the page asked the reader to be shown — and the first
    // few reports of the tree's position after it are checked against that:
    // agreement, and the tree is the reader's again; disagreement, and the pane
    // asks once more, for as little as it has `insist` left. That is the difference
    // between a row that arrives and a row that almost did.
    changed shown-from => {
        observed(shown-from);
        if (goal >= 0px) {
            if (turns <= 0) {
                goal = -1px;
            } else if (shown-from == goal) {
                // The tree agrees with the page. Keep the number a moment in case
                // it changes its mind, and stop asking either way.
                hold = shown-from;
                hold-turns = 2;
                goal = -1px;
            } else {
                // A snap-back, or the next stride of the pan.
                ask();
            }
        } else if (hold >= 0px && hold-turns > 0) {
            hold-turns -= 1;
            if (shown-from != hold) {
                if (insist <= 0) {
                    hold = -1px;
                } else {
                    insist -= 1;
                    scrolled(-hold);
                }
            } else {
                // Confirmed: the tree is where the page wanted it, and it is on its
                // own from here.
                hold = -1px;
            }
        }
    }
}

/// URL bar wrapper: bumps `focus-token` (from Rust / Ctrl-L / F6) to grab
/// focus and highlight the whole address, so typing replaces it outright.
///
/// While the autocomplete dropdown is open (task: URL bar autocomplete) the
/// arrow keys, Enter and Escape belong to the dropdown rather than to the
/// entry: Rust opens it (and keeps re-ranking it from the visit log on every
/// keystroke via `edited`), owns the highlighted row, and is the only thing
/// that closes it again. Enter with no highlighted row falls through to the
/// entry's default — plain `submitted` of the draft, unchanged behaviour.
component UrlBar inherits Rectangle {
    in property <int> focus-token: 0;
    in-out property<string> text <=> edit.text;
    callback submitted(text: string);
    callback edited(text: string);
    callback suggest-move(delta: int);
    callback suggest-pick(idx: int);
    callback suggest-close();
    /// Browser chords asked of Rust while the entry is focused (task: keep
    /// keyboard shortcuts usable while the URL bar is focused): Rust answers
    /// whether the chord is one of the browser's and has acted on it — in
    /// which case the key is consumed and the LineEdit never sees it.
    callback chord(text: string, ctrl: bool, shift: bool, alt: bool, meta: bool) -> bool;
    // the entry's live focus state, so AppWindow can gate the dropdown on it:
    // clicking into the page hides the panel even before Rust clears the flag
    out property <bool> edit-focus: edit.has-focus;
    in property <bool> suggest-open: false;
    in property <int> suggest-selected: -1;
    edit := LineEdit {
        width: parent.width;
        height: parent.height;
        placeholder-text: "Search or enter address — Ctrl-L or F6 to focus";
        accepted(txt) => { root.submitted(txt); }
        edited(txt) => { root.edited(txt); }
        key-pressed(ev) => {
            if (root.suggest-open) {
                if (ev.text == Key.DownArrow) {
                    root.suggest-move(1);
                    return EventResult.accept;
                }
                if (ev.text == Key.UpArrow) {
                    root.suggest-move(-1);
                    return EventResult.accept;
                }
                if (ev.text == Key.Return && root.suggest-selected >= 0) {
                    root.suggest-pick(root.suggest-selected);
                    return EventResult.accept;
                }
                if (ev.text == Key.Escape) {
                    root.suggest-close();
                    return EventResult.accept;
                }
            }
            // Task: keep keyboard shortcuts usable while the URL bar is
            // focused — a modifier chord (and the modifierless function-key
            // chords: F1 = U+F704 … F12 = U+F70F, F6 included, Esc excluded)
            // is offered to Rust before the LineEdit's own editing swallows
            // it. Plain typing, caret motion and the entry's editing chords
            // (Ctrl-A/C/V/X/Y/Z) answer "not mine" and edit as always.
            if (ev.modifiers.control || ev.modifiers.alt || ev.modifiers.meta
                || (ev.text >= "\u{F704}" && ev.text <= "\u{F70F}")) {
                if (root.chord(ev.text, ev.modifiers.control, ev.modifiers.shift,
                        ev.modifiers.alt, ev.modifiers.meta)) {
                    return EventResult.accept;
                }
            }
            return EventResult.reject;
        }
    }
    // armed on token bumps only (> 0), so clicking out of the bar does not
    // yank focus back
    changed focus-token => {
        if (root.focus-token > 0) {
            edit.focus();
            edit.select-all();
        }
    }
}

/// Find-in-page bar (Ctrl-`F`): a strip that floats over the top-right of the
/// page — the text entry, the live counter the tab reports (`3 / 12`, `No
/// results`), ▲/▼ to walk the results, and ✕ to close it. Enter jumps forward,
/// Shift-Enter and the arrow keys backward; every edit re-searches at once.
/// The highlights themselves are painted by the tab (its document, its pixels):
/// yellow behind every match, light blue behind the one this bar sits on.
component FindBar inherits Rectangle {
    /// Bumped by Rust (Ctrl-`F`) to pull focus into the entry.
    in property <int> focus-token: 0;
    /// The tab's counter, verbatim (see `FindState::label` in src/state.rs).
    in property <string> count: "";
    /// The query in the entry (two-way with the shell).
    in-out property <string> text: "";
    callback query-changed(text: string);
    callback next();
    callback previous();
    callback close();
    /// Browser chords while this bar is focused (task: keep keyboard
    /// shortcuts usable while the URL bar is focused) — same contract as the
    /// URL bar's `chord`; Rust answers whether it acted.
    callback chord(text: string, ctrl: bool, shift: bool, alt: bool, meta: bool) -> bool;

    width: 372px;
    height: 40px;

    // The panel: opaque, so the page under it stays legible as a background.
    Rectangle {
        width: parent.width;
        height: parent.height - 8px;
        background: #242424;
        border-radius: 6px;
        border-width: 1px;
        border-color: #5a5a5a;
        // Nothing behind the panel may take the click (the page's TouchArea
        // covers the same pixels and would otherwise swallow the bar's own).
        find-scrim := TouchArea { }

        HorizontalLayout {
            x: 0; width: parent.width; height: parent.height;
            padding-left: 8px; padding-right: 8px;
            spacing: 6px;
            alignment: center;

            find-input := LineEdit {
                placeholder-text: "Find in page";
                text <=> root.text;
                // Enter → next, Shift-Enter / ↑ → previous, ↓ → next, Esc →
                // close. Intercepted here rather than via `accepted` so the
                // shifted chord reaches Rust too instead of beeping, and
                // `edited` (below) carries the typing itself.
                edited(txt) => { root.query-changed(txt); }
                key-pressed(ev) => {
                    if (ev.text == Key.Escape) {
                        root.close();
                        return EventResult.accept;
                    }
                    if (ev.text == Key.Return) {
                        if (ev.modifiers.shift) { root.previous(); } else { root.next(); }
                        return EventResult.accept;
                    }
                    if (ev.text == Key.UpArrow) {
                        root.previous();
                        return EventResult.accept;
                    }
                    if (ev.text == Key.DownArrow) {
                        root.next();
                        return EventResult.accept;
                    }
                    // Browser chords reach the shell from here too (task:
                    // keep keyboard shortcuts usable while a bar is focused).
                    if (ev.modifiers.control || ev.modifiers.alt || ev.modifiers.meta
                        || (ev.text >= "\u{F704}" && ev.text <= "\u{F70F}")) {
                        if (root.chord(ev.text, ev.modifiers.control, ev.modifiers.shift,
                                ev.modifiers.alt, ev.modifiers.meta)) {
                            return EventResult.accept;
                        }
                    }
                    return EventResult.reject;
                }
            }

            Text {
                text: root.count;
                color: root.count == "No results" ? #e06666 : #a8b8c8;
                font-size: 12px;
                vertical-alignment: center;
            }
            MiniButton { label: "▲"; clicked => { root.previous(); } }
            MiniButton { label: "▼"; clicked => { root.next(); } }
            MiniButton { label: "×"; clicked => { root.close(); } }
        }
    }

    // Armed on token bumps only (> 0), like the URL bar: clicking away into the
    // page must not yank the caret back into the entry.
    changed focus-token => {
        if (root.focus-token > 0) { find-input.focus(); }
    }
}

/// The page's keyboard focus holder. Every key press is forwarded to Rust
/// (consumed so Slint never beeps); Rust either acts on a browser chord or
/// relays a ToTab::Key to the active tab process.
component PageSurface inherits FocusScope {
    in property <int> focus-token: 0;
    callback key(pressed: bool, text: string, ctrl: bool, shift: bool, alt: bool, meta: bool, repeat: bool);
    changed focus-token => {
        if (root.focus-token > 0) { self.focus(); }
    }
    key-pressed(ev) => {
        root.key(true, ev.text, ev.modifiers.control, ev.modifiers.shift, ev.modifiers.alt, ev.modifiers.meta, ev.repeat);
        return EventResult.accept;
    }
    key-released(ev) => {
        root.key(false, ev.text, ev.modifiers.control, ev.modifiers.shift, ev.modifiers.alt, ev.modifiers.meta, ev.repeat);
        return EventResult.accept;
    }
}

/// One row (or the caption row) of the DevTools network table: Method | URL |
/// Initiator | Status | Size | Time, laid out with explicit geometry so
/// captions and data line up, and the URL is the column that absorbs the
/// window's width.
component NetRowCells inherits Rectangle {
    in property <string> method: "";
    in property <string> url: "";
    in property <string> initiator: "";
    in property <string> status: "";
    in property <string> bytes: "";
    in property <string> time: "";
    in property <color> cell-color: #cfcfcf;
    in property <color> status-color: root.cell-color;

    m := Text {
        x: 8px; width: 56px; height: parent.height;
        text: root.method; color: root.cell-color;
        vertical-alignment: center; overflow: elide;
    }
    u := Text {
        x: 70px; width: Math.max(60px, parent.width - 382px); height: parent.height;
        text: root.url; color: root.cell-color;
        vertical-alignment: center; overflow: elide;
    }
    i := Text {
        x: parent.width - 312px; width: 80px; height: parent.height;
        text: root.initiator; color: root.cell-color;
        vertical-alignment: center; overflow: elide;
    }
    s := Text {
        x: parent.width - 232px; width: 100px; height: parent.height;
        text: root.status; color: root.status-color;
        vertical-alignment: center; overflow: elide;
    }
    sz := Text {
        x: parent.width - 132px; width: 66px; height: parent.height;
        text: root.bytes; color: root.cell-color;
        vertical-alignment: center; overflow: elide;
    }
    t := Text {
        x: parent.width - 62px; width: 54px; height: parent.height;
        text: root.time; color: root.cell-color;
        vertical-alignment: center; overflow: elide;
    }
}

export component AppWindow inherits Window {
    title: "IronSurf";
    background: #1f1f1f;
    min-width: 640px;
    min-height: 480px;

    // ------------------------------------------------------------------
    // state pushed from Rust
    // ------------------------------------------------------------------
    in property <[TabInfo]> tabs;
    in property <[ContainerInfo]> containers;
    in property <image> page-image;
    // two-way alias: Rust pushes URLs here and they propagate to the URL bar
    // reader view (task: reader mode): mirrors the active tab's reader state
    // onto the 📄 toolbar button; the chord and the button both fire
    // `reader-toggled`, and the tab's `ReaderState` answer moves the state
    // back (it also refuses, so the button never lies about a no-op).
    in property <bool> reader-on: false;
    callback reader-toggled();

    // popups (task: block popups): the ⛔ button mirrors whether the active
    // tab's blocker stands, and holds-in while it does (blocking is the default,
    // so the button starts pressed). `popup-allow-site` is "this site may open
    // windows anyway" — Ctrl-Alt-`P`, the same command the status-line notice
    // names after a blocked popup. Neither says anything about the user's own
    // clicks: those open windows while the switch is up.
    in property <bool> popup-blocked: true;
    callback popup-block-toggled();
    callback popup-allow-site();

    /// What ⛔ says while the pointer rests on it: `popups blocked` while the
    /// active tab's blocker stands, `popups allowed` once it has been lowered
    /// (task: popup blocker tooltip). Rust pushes it *with* the switch, so the
    /// words change in the same click that changes the icon — the pointer does
    /// not have to leave the button and come back to find out what it just did.
    in property <string> popup-tip: "popups blocked";

    // The one hover tooltip the whole window shares (task: popup blocker
    // tooltip): a button reports a hover and the single overlay at the end of
    // this component draws it, which is why *where* has to be carried up here —
    // a tooltip hung off the button itself is a descendant of the toolbar and
    // would paint under the page declared after it. No hover delay: the pointer
    // is already on the thing the reader is asking about.
    in-out property <bool> tip-on: false;
    in-out property <length> tip-x: 0px;
    in-out property <length> tip-y: 0px;
    /// The words a *non-toolbar* control has to say (task: tab strip fits the
    /// bar): a tab's hover puts the tab's full, un-elided title here and the one
    /// overlay shows it, because the row itself can only ever show as much of a
    /// title as the tab's share of the bar holds. Empty everywhere else, which
    /// is what lets ⛔ keep speaking through `popup-tip` untouched.
    in-out property <string> tip-text: "";

    in-out property<string> url-text <=> url-bar.text;
    in property <string> status-text;
    in property <string> sec-glyph: "";
    in property <color> sec-color: #888888;
    in property <string> spinner: " ";
    /// Whether the **active** tab is loading (a copy of its `loading` state,
    /// pushed by Rust with every `LoadingChanged` / UI sync). Drives the
    /// indeterminate progress bar at the left end of the status bar: the bar
    /// only exists while this is true, and each transition re-triggers its
    /// sweep animation from the left edge.
    in property <bool> loading: false;
    /// Sweep position of the loading bar: 0 … 12, where 0 sits the lit
    /// segment at the track's left end and 12 at its right end (4 px a step,
    /// 96 px wide track). Rust advances it from the spinner timer — one step
    /// per 120 ms while a load is in flight, ping-ponging — and zeroes it the
    /// instant a load starts, so every navigation begins the sweep afresh.
    in property <int> load-progress: 0;
    in property <string> container-label: "";
    /// Private browsing (task): true while the container of the tab **on
    /// screen** browses privately — the top bar's ◒ badge lights up, so the
    /// user always sees which mode the visible tab is in. Per container,
    /// not a global switch; Rust pushes it with the label on every tab
    /// switch and every toggle.
    in property <bool> container-private: false;
    in property <bool> can-back: false;
    in property <bool> can-fwd: false;
    in property <bool> manager-open: false;
    in property <int> editing-index: -1;
    in-out property <string> container-edit-text;
    in property <int> selected-container: 0;
    in property <int> active-index: 0;
    // bumped by Rust to move focus programmatically (Ctrl-L / Esc / startup,
    // and every newly opened tab)
    in property <int> focus-url-token: 0;
    // find-in-page bar (Ctrl-F): `find-open` is per active tab (the tab record
    // owns the flag, like DevTools), `find-count` is the tab's own reported
    // counter, `find-text` the query in the entry (two-way: Rust pushes a
    // surviving query when the bar reopens), and `find-focus-token` is bumped
    // to pull the caret into the entry.
    in property <bool> find-open: false;
    in property <string> find-count: "";
    in-out property <string> find-text: "";
    in property <int> find-focus-token: 0;
    callback find-query-changed(text: string);
    callback find-next();
    callback find-previous();
    callback find-close();
    in-out property <int> focus-page-token: 0;
    // page area size, read by Rust to send ToTab::Resize
    out property <length> page-width: page.width;
    out property <length> page-height: page.height;
    // hover cursor (task: cursor icon): the shape a tab wants over its page
    // (`FromTab::CursorChanged`), pushed by Rust onto the page TouchArea.
    in property <MouseCursor> page-cursor;
    // whether the pointer is over the page, and its last position in WINDOW
    // coordinates: when a new shape arrives Rust re-dispatches a pointer
    // move there — Slint only re-reads a TouchArea's `mouse-cursor` while
    // processing a pointer event, and the mouse may have stopped the instant
    // the tab answered.
    out property <bool> page-pointer-inside: ta.has-hover;
    out property <length> pointer-x-in-window: page-frame.absolute-position.x + ta.mouse-x;
    out property <length> pointer-y-in-window: page-frame.absolute-position.y + ta.mouse-y;
    // overlay scroll bar (task: scroll bar): the page's own scroll position,
    // drawn over its right edge. Whether it is up is Rust's call and arrives
    // as one bool — the tab reports its document's scroll geometry
    // (`FromTab::ScrollState`), and the bar shows while the page is being
    // scrolled, hiding itself a few seconds after the last movement. Where the
    // thumb sits is Rust's too: the track is this panel's height, the geometry
    // is the tab's, and the two only ever meet in Rust. The fade is here, so a
    // hide costs the pump one bool.
    in property <bool> scrollbar-visible: false;
    // Thumb in page-area px from its top edge, from the tab's geometry: at the
    // document's scroll limit the thumb's bottom edge lands on the track's end.
    in property <length> scrollbar-thumb-y: 0px;
    in property <length> scrollbar-thumb-height: 0px;
    // right-click context menu (task: context menu): opened by Rust when a
    // tab reports `FromTab::ContextMenu`; (menu-x, menu-y) is in page-area
    // coordinates, items are labels only — Rust maps the picked index onto
    // the real action.
    in property <bool> menu-open: false;
    in property <length> menu-x: 0px;
    in property <length> menu-y: 0px;
    in property <[MenuItem]> menu-items;
    // JS dialog (task: window.alert/confirm/prompt): opened by Rust when a
    // tab reports `FromTab::DialogRequest`; the requesting tab is activated
    // first, so the modal always belongs to the page on screen. Rust keeps
    // the (tab, dialog id) pair and answers over the wire when the user
    // presses a button. kind: 0 alert, 1 confirm, 2 prompt.
    in property <bool> dialog-open: false;
    in property <int> dialog-kind: 0;
    in property <string> dialog-message: "";
    in property <string> dialog-title: "";
    in-out property <string> dialog-input: "";

    // DevTools panel (task: DevTools UI): bottom-docked over the page area of
    // the *active* tab. Rust owns the open/closed flag (per tab) and the view
    // choice, and pushes the reduced console/network rows on every drain tick
    // while the panel is open.
    in property <bool> devtools-open: false;
    in property <int> devtools-view: 0; // 0 = Console, 1 = Network
    // How tall the panel is. Rust owns the number **per tab** and pushes the
    // active tab's, so one tab can sit tall while another stays short, and a
    // drag on this tab never resizes that one. What Rust sends is already
    // folded into the page area it docks into (see `clamp_devtools_height`),
    // so the panel paints exactly this; `devtools-edge` is how the reader
    // changes it.
    in property <length> devtools-height: 240px;
    in property <int> console-count: 0;
    in property <int> network-count: 0;
    in property <[ConsoleRow]> console-rows;
    in property <[NetRow]> net-rows;
    // Copy in the DevTools tabs: `true` while the current pane has something
    // to copy — a highlighted Console/Network row, or the Inspector's selected
    // node — which is what enables the header's `Copy` button. Rust owns it
    // (see `app::Core::write_devtools`).
    in property <bool> devtools-copy-available: false;
    // DevTools **Inspector** pane (third pane, `devtools-view == 2`). The tab
    // owns the document and sends a flat `InspectSnapshot`; Rust folds it,
    // selects, builds the breadcrumb and re-renders the markup as tokens, then
    // pushes the result here: `inspector-count` is the element count on the
    // header button (dim while `inspector-truncated`), `inspector-pick` says
    // ⌖ is armed for this tab, `inspector-summary` names the document, the
    // breadcrumb is clickable, and `inspector-empty`/`inspector-hint` is the
    // honest empty state (never a blank rectangle).
    in property <int> inspector-count: 0;
    in property <bool> inspector-truncated: false;
    in property <bool> inspector-pick: false;
    in property <string> inspector-summary: "";
    in property <bool> inspector-empty: false;
    in property <string> inspector-hint: "";
    in property <[InspectRow]> inspector-rows;
    in property <[CrumbItem]> inspector-crumb;
    // Where the tree should scroll to. Selecting *on the page* (⌖ pick, right-click
    // → Inspect Element) names a node that can sit far below the fold, so Rust puts
    // its row here: `inspector-reveal-row` is the row (`-1` = nothing owed) and
    // `inspector-reveal-token` counts the requests, which is what the tree watches —
    // picking the same node again after scrolling away has to move too.
    in property <int> inspector-reveal-row: -1;
    in property <int> inspector-reveal-token: 0;
    /// How far the Inspector tree is scrolled, as the tree itself reported it:
    /// what the pane did with a request.
    out property <length> inspector-shown-from: 0px;

    // Userscript menu (task: userscript menu): toggled by the "</>" toolbar
    // button. Rust owns the open flag, re-pushes `us-scripts` from the Store
    // after every mutation, and keeps `(us-editing, us-name, us-patterns,
    // us-code)` as the inline editor — opened by "+ New script" **or** by
    // clicking a row (`us-edit(idx)` prefills that script; `us-editing-existing`
    // tells the heading which mode is up). A failed Save leaves the
    // editor up with `us-error` set and the script NOT added.
    in property <bool> us-menu-open: false;
    in property <[UserscriptRow]> us-scripts;
    in property <bool> us-editing: false;
    // true while the editor holds a *pre-filled existing* script (upsert,
    // same id), false for a fresh "+ New script" draft.
    in property <bool> us-editing-existing: false;
    in property <string> us-error: "";
    in-out property <string> us-name: "";
    in-out property <string> us-patterns: "";
    in-out property <string> us-code: "";

    // User-Agent switcher (task: per-container UA): toggled by the "UA"
    // toolbar button and scoped to the *active tab's container*. Rust owns
    // the open flag, re-pushes `ua-rows`/`ua-current` from the Store after
    // every mutation and after every tab switch, and shows a rejected custom
    // string as the one-line `ua-error` (the draft in the LineEdit survives).
    in property <bool> ua-menu-open: false;
    in property <[UaRow]> ua-rows;
    in property <string> ua-current: "";
    in property <string> ua-error: "";
    // the custom-UA LineEdit (mirrored so the Apply button, a sibling, can
    // hand its text back — ids are only visible to descendants — and so a
    // rejected Apply keeps the draft while `ua-error` says why)
    in-out property <string> ua-custom: "";

    // Proxy pickers + definition editor (task: proxies): **no toolbar
    // button of its own** — this state renders inside the settings drawer
    // (☰), scoped to the *active tab's container* exactly like the UA menu.
    // `proxy-rows` is Direct first, then one row per global definition
    // (settings `ui.json → proxies`); clicking a row stores the choice (a
    // definition **name**) on the container and rebroadcasts
    // `ToTab::SetProxy` with the resolved URL. `proxy-current` is the
    // display label ("Direct" or a name); `proxy-error` is the one-line
    // rejection of a bad definition (the Add drafts survive, UA-menu
    // style). Definitions are **global**: every container may pick the same
    // one, and deleting/editing one re-resolves every container.
    in property <[ProxyRow]> proxy-rows;
    in property <string> proxy-current: "";
    in property <string> proxy-error: "";
    in-out property <string> proxy-add-name: "";
    in-out property <string> proxy-add-url: "";

    // Archive mode (the 💾 toggle): Rust owns every value — `archive-enabled`
    // mirrors the live setting (off by default, persisted), `archive-dir-text`
    // is the root folder (prefilled with the effective one, the built-in
    // default being $HOME/Downloads/ironsurf-tabs), `archive-status` is the
    // one-line summary under the CheckBox, and `archive-error` the one-line
    // rejection of a bad folder (the draft survives, UA-menu style).
    in property <bool> archive-menu-open: false;
    in-out property <bool> archive-enabled: false;
    in-out property <string> archive-dir-text: "";
    in property <string> archive-status: "";
    in property <string> archive-error: "";

    // Downloads menu (task: file downloads): opened by the ⬇ button beside the
    // archive's 💾. `downloads` are the active tab's rows (newest first — a
    // tab's downloads die with its process, so another tab's list is never
    // mixed in), `download-status` is the one-line folder summary under the
    // header, and `download-dir-text` the folder draft (prefilled with the
    // effective root, default `$HOME/Downloads`) whose `download-error`
    // carries a rejection. `Clear finished` drops the settled rows, never the
    // files they named.
    in property <bool> download-menu-open: false;
    in-out property <string> download-dir-text: "";
    in property <string> download-status: "";
    in property <string> download-error: "";
    in property <[DownloadItem]> downloads;

    // Settings drawer (task: browsing history), opened by the ☰ button at the
    // right-hand end of the toolbar, next to the container dropdown. It is
    // **settings** — the visits are not listed here any more, they have their
    // own page (`ironsurf://history`, opened by the drawer's History button);
    // `history-status` is the one-line count of the shared log under the
    // header, so Clear says what it is about to delete. Clearing is
    // all-or-nothing: it wipes the shared log, never one container's slice.
    in property <bool> history-menu-open: false;
    in property <string> history-status: "";

    // Settings (task: settings menu): the ☰ panel doubles as the browser's
    // one settings area, and the wheel scroll-speed slider down at its bottom
    // writes this multiplier — `1.0` is the default damping.
    in-out property <float> scroll-speed: 1.0;

    // "Save page" dialog (task: save-page selector). Ctrl-S opens it —
    // pressing it again closes it. `save-page` is the page about to be saved
    // (its address, for the header line); `save-dir-text` is the folder draft
    // (prefilled with the ⬇ root, i.e. the default `$HOME/Downloads`; Choose
    // validates it with the ⬇ panel's rules and a refusal keeps the draft),
    // `save-name-text` the file-name draft (prefilled from the URL or the
    // page title), and `save-error` carries a one-line refusal. Save asks the
    // tab to write the file; the result shows up in the ⬇ panel. Rust owns
    // the open flag.
    in property <bool> save-menu-open: false;
    in property <string> save-page: "";
    in-out property <string> save-dir-text: "";
    in-out property <string> save-name-text: "";
    in property <string> save-error: "";

    // URL bar autocomplete (task: URL bar autocomplete): while the address-bar
    // draft still matches visits in the shared log, Rust keeps `suggest-items`
    // ranked (URL prefix → URL substring → title match, recency breaking
    // ties, ≤ 8 rows), `suggest-selected` highlighted, and `suggest-open`
    // true; the entry itself routes ↑/↓/Enter/Esc to the panel while it is
    // open (see `UrlBar`). The panel is the only surface that ever shows
    // these rows — nothing here rewrites the draft behind the user's back.
    in property <bool> suggest-open: false;
    in property <[SuggestItem]> suggest-items;
    in property <int> suggest-selected: -1;

    // ------------------------------------------------------------------
    // intents surfaced to Rust
    // ------------------------------------------------------------------
    callback go-back();
    callback go-forward();
    callback reload();
    callback new-tab();
    callback navigate(url: string);
    /// URL-bar-focused browser chords (task: keep keyboard shortcuts usable
    /// while the URL bar is focused): Rust answers true when the chord is a
    /// browser one (from `keymap::bar_shortcut`) and has just acted on it.
    callback url-chord(text: string, ctrl: bool, shift: bool, alt: bool, meta: bool) -> bool;
    /// The find bar's mirror of `url-chord`.
    callback find-chord(text: string, ctrl: bool, shift: bool, alt: bool, meta: bool) -> bool;
    callback activate-tab(idx: int);
    callback close-tab(idx: int);
    callback open-manager();
    callback close-manager();
    callback mgr-new-tab-in(idx: int);
    callback mgr-move-tab-to(idx: int);
    callback mgr-delete(idx: int);
    callback mgr-start-rename(idx: int);
    callback mgr-rename(idx: int);
    callback mgr-add();
    callback mgr-recolor(idx: int, palette: int);
    callback mgr-select(idx: int);
    /// The container manager's Private checkbox (task: private browsing):
    /// flip the flag for row `idx`, push DNT to that container's live tabs,
    /// restamp the top-bar badge when the container is the active one.
    callback mgr-toggle-private(idx: int);
    // raw keyboard/pointer events from the page; Rust decides chords
    callback page-key(pressed: bool, text: string, ctrl: bool, shift: bool, alt: bool, meta: bool, repeat: bool);
    // kind: 0 move, 1 down, 2 up, 4 out — button: 0 left, 1 right, 2 middle
    // The modifiers ride along for the mouse chords: a middle click, or a
    // Ctrl-left / (macOS) ⌘-left click on a link, opens it in a new tab — and
    // only the tab can tell whether a link is under the cursor at all.
    // Slint reports Command in `control` on macOS and Control in `meta`, so the
    // tab is given both flags and decides per platform.
    callback page-pointer(x: length, y: length, kind: int, button: int,
                          ctrl: bool, shift: bool, alt: bool, meta: bool);
    callback page-wheel(x: length, y: length, delta-x: length, delta-y: length);
    // context-menu intents (index into `menu-items`)
    callback menu-pick(idx: int);
    callback menu-close();
    // DevTools intents: pick a pane (0 console / 1 network) or close the panel.
    callback devtools-select-view(view: int);
    callback devtools-close();
    // `Clear` on the visible pane's feed (Console / Network), ⌖ *inspect
    // element* toggle, and the two Inspector intents: a tree row clicked
    // (`ToTab::InspectSelect`, the tab paints its box) and a `+/−` twisty
    // (folding is the shell's own business — nothing goes over the wire).
    callback devtools-clear();
    callback devtools-toggle-pick();
    callback devtools-select-node(node: int);
    callback devtools-toggle-fold(node: int);
    // Copy gestures (task: copy in the DevTools tabs): clicking a Console
    // (pane 0) or Network (pane 1) row highlights it, a double-click
    // highlights *and* copies it (`index` is the node id on pane 2, the
    // Inspector), and the header `Copy` copies what the pane has highlighted.
    callback devtools-select-row(pane: int, index: int);
    callback devtools-copy-row(pane: int, index: int);
    callback devtools-copy();
    /// The panel's top edge is being dragged: 0 = the press, 1 = a move, 2 = the
    /// release, with `travel` how far the pointer has come from the point it was
    /// grabbed at — positive **up**, the direction that makes the panel taller.
    /// The height itself stays Rust's business (it is per tab, and the floor and
    /// ceiling are its call), so the press is where Rust notes where the panel
    /// stood and every move is measured off that note rather than off the last
    /// one: clamping at a bound cannot then leak travel into a drift.
    callback devtools-edge(kind: int, travel: length);
    // JS-dialog intents: `OK` (accepted, `dialog-input` carries the prompt
    // text) or `Cancel`/Esc (dismissed). The scrim deliberately does nothing
    // — a modal is dismissed by an answer, never by clicking past it.
    callback dialog-accept();
    callback dialog-cancel();

    // Userscript-menu intents (indices are rows of `us-scripts`; Rust maps
    // them back onto script ids). Toggle/delete/save persist through the
    // Store at once and rebroadcast the enabled set to every live tab.
    callback toggle-us-menu();
    callback close-us-menu();
    callback us-toggle(idx: int);
    callback us-delete(idx: int);
    // row clicked (anywhere but the CheckBox / ✕): edit that script.
    callback us-edit(idx: int);
    callback us-new();
    callback us-save();
    callback us-cancel();

    // User-Agent-menu intents (indices are rows of `ua-rows`; Rust maps them
    // back onto preset strings). Every accepted choice persists through the
    // Store at once and rebroadcasts ToTab::SetUserAgent to the live tabs of
    // the *container the menu belongs to* only.
    callback toggle-ua-menu();
    callback close-ua-menu();
    callback ua-select(idx: int);
    callback ua-copy();
    callback ua-restore-default();
    // the custom-UA LineEdit → Apply (its current text, blank = default).
    callback ua-apply-custom(text: string);

    // Proxy intents (task: proxies; the settings drawer's proxy section;
    // indices are rows of `proxy-rows`, row 0 = Direct). Selecting persists
    // the definition **name** on the container through the Store and
    // rebroadcasts the resolved URL to that container's live tabs only;
    // add/delete change the global pool, save the settings, and re-resolve
    // every live tab (a container whose definition vanished goes direct,
    // its stored name kept as typed).
    callback proxy-select(idx: int);
    callback proxy-delete(idx: int);
    callback proxy-add();

    // Archive-menu intents: the CheckBox flips the mode (broadcast to every
    // live tab at once, global — not per-container), the LineEdit → Apply
    // re-points the root folder (validated in Rust; rejected → `archive-error`).
    callback toggle-archive-menu();
    callback close-archive-menu();
    callback archive-set-enabled(on: bool);
    callback archive-apply-dir(text: string);

    // Download-menu intents (task: file downloads): Apply re-points the folder
    // (validated in Rust; rejected → `download-error`), `Clear finished` drops
    // the settled rows of every live tab. Nothing here fetches or writes — the
    // tab fetches and the pump writes.
    callback toggle-download-menu();
    callback close-download-menu();
    callback download-apply-dir(text: string);
    callback download-clear-finished();

    // Settings-drawer intents (task: browsing history): **History** opens the
    // `ironsurf://history` page in a new tab; Clear wipes the whole shared log.
    callback toggle-history-menu();
    callback close-history-menu();
    callback history-page();
    callback history-clear();
    callback scroll-speed-set(speed: float);

    // "Save page" dialog callbacks (task: save-page selector): Choose
    // validates the typed folder (the ⬇ panel's rules); Save confirms the
    // name and asks the tab for the page that way. Neither fetches anything —
    // the tab does, and the ⬇ panel shows it.
    callback close-save-menu();
    callback save-pick-folder(text: string);
    callback save-page-confirm(text: string);
    // URL bar autocomplete (task: URL bar autocomplete): `url-edited` fires on
    // every keystroke in the bar (Rust re-ranks the dropdown from the shared
    // visit log), the rest come from the panel's rows and the entry's routed
    // keys.
    callback url-edited(text: string);
    callback suggest-move(delta: int);
    callback suggest-pick(idx: int);
    callback suggest-close();

    // Console severity: icon + colour (error red, warn yellow, info/log grey).
    function devtools-level-icon(level: string) -> string {
        if (level == "error") { return "\u{2715}"; }
        if (level == "warn") { return "⚠"; }
        if (level == "info") { return "i"; }
        return "\u{203A}";
    }

    function devtools-level-color(level: string) -> color {
        if (level == "error") { return #ef5350; }
        if (level == "warn") { return #e6c07b; }
        if (level == "info") { return #b8b8b8; }
        return #9a9a9a;
    }

    // The Inspector's fixed colour table (see `state::TOK_*`): punctuation
    // grey, tag name orange, attribute name blue, attribute value green, text
    // near-white, comment/doctype grey (italic comes from the row), `id`/`class`
    // values and dangerous ones (`<script>`/`<style>`/`<head>`, `data:` URLs)
    // their own colours.
    function inspect-kind-color(kind: int) -> color {
        if (kind == 0) { return #e6e6e6; } // text
        if (kind == 1) { return #e8a33d; } // tag name
        if (kind == 2) { return #6aa6ff; } // attribute name
        if (kind == 3) { return #7ec96f; } // attribute value
        if (kind == 4) { return #8a8a8a; } // punctuation
        if (kind == 5) { return #ef5350; } // danger
        if (kind == 6) { return #8a8a8a; } // comment
        if (kind == 7) { return #8a8a8a; } // doctype
        if (kind == 8) { return #c586c0; } // id / class value
        return #cfcfcf;
    }

    // fixed palette; index also addresses `palette-color` for add/rename
    function palette-color(idx: int) -> color {
        if (idx == 0) { return #4a90d9; }
        if (idx == 1) { return #e06666; }
        if (idx == 2) { return #6aa84f; }
        if (idx == 3) { return #f6b26b; }
        if (idx == 4) { return #8e7cc3; }
        if (idx == 5) { return #6d4c41; }
        if (idx == 6) { return #0097a7; }
        return #9e9e9e;
    }

    VerticalLayout {
        width: parent.width;
        height: parent.height;

        // ---- toolbar -----------------------------------------------------
        Rectangle {
            height: 38px;
            background: #2b2b2b;

            // The bar fills the window (the url-bar below stretches to eat
            // whatever is left), so the rightmost ☰ history button sits inside
            // the window instead of drifting off the right edge when the
            // window or the OS fonts are narrow/wide.
            HorizontalLayout {
                x: 8px;
                width: parent.width - 16px;
                height: parent.height;
                cross-axis-alignment: center;
                spacing: 6px;

                MiniButton { label: "←"; enabled: root.can-back; clicked => { root.go-back(); } }
                MiniButton { label: "→"; enabled: root.can-fwd; clicked => { root.go-forward(); } }
                MiniButton { label: "⟳"; clicked => { root.reload(); } }

                url-bar := UrlBar {
                    min-width: 160px;
                    horizontal-stretch: 1;
                    focus-token: root.focus-url-token;
                    submitted(txt) => { root.navigate(txt); }
                    edited(txt) => { root.url-edited(txt); }
                    suggest-open: root.suggest-open;
                    suggest-selected: root.suggest-selected;
                    suggest-move(d) => { root.suggest-move(d); }
                    suggest-pick(i) => { root.suggest-pick(i); }
                    suggest-close() => { root.suggest-close(); }
                    chord(t, c, s, a, m) => { return root.url-chord(t, c, s, a, m); }
                }

                MiniButton { label: "＋"; clicked => { root.new-tab(); } }

                // reader view (task: reader mode): the 📄 — paper with text —
                // swaps the page for its cleaned-up text-and-images rendering
                // and stays held-in while it is on; Ctrl-Alt-`R` is the same
                // command.
                MiniButton { label: "\u{1F4C4}"; checked: root.reader-on; clicked => { root.reader-toggled(); } }

                // popups (task: block popups): ⛔ — no entry — pressed while the
                // blocker stands, which is every tab's starting state; releasing
                // it lets this tab's pages open windows unasked. Hovering it says
                // which of the two the active tab is doing right now.
                pop-btn := MiniButton {
                    label: "\u{26D4}";
                    checked: root.popup-blocked;
                    tip: root.popup-tip;
                    clicked => { root.popup-block-toggled(); }
                    tip-entered() => {
                        root.tip-x = pop-btn.absolute-position.x;
                        root.tip-y = pop-btn.absolute-position.y + pop-btn.height + 6px;
                        root.tip-on = true;
                    }
                    tip-exited() => { root.tip-on = false; }
                }

                // userscript menu (task: userscript menu)
                MiniButton { label: "</>"; clicked => { root.toggle-us-menu(); } }

                // User-Agent switcher (task: per-container UA) — same house
                // pattern as the "</>" button directly to its left.
                MiniButton { label: "UA"; clicked => { root.toggle-ua-menu(); } }

                // archive mode (task: archive mode) — same house pattern
                // again; the glyph doubles as the on/off state hint in the
                // overlay, the button only ever toggles the menu.
                MiniButton { label: "\u{1F4BE}"; clicked => { root.toggle-archive-menu(); } }

                // downloads (task: file downloads) — the ⬇ beside the archive
                // button it shares a folder-with-draft pattern with: the same
                // house rule for the button (it only ever toggles the overlay).
                MiniButton { label: "\u{2B07}"; clicked => { root.toggle-download-menu(); } }

                // private browsing (task: private browsing) — a badge that
                // sits beside the container dropdown and only exists while
                // the visible tab's container browses privately: DNT on,
                // nothing written to the shared history. Per container —
                // Rust pushes `container-private` with the label, so the
                // badge always speaks about the tab on screen.
                Rectangle {
                    visible: root.container-private;
                    height: 24px;
                    width: priv-lbl.preferred-width + 16px;
                    bgrp := Rectangle { background: #6b2fbf; border-radius: 4px; }
                    priv-lbl := Text {
                        text: "\u{25C9} private";
                        color: #ffffff;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // container dropdown: shows the active tab's container,
                // opens the manager on click
                Rectangle {
                    height: 24px;
                    width: Math.max(80px, cont-lbl.preferred-width + 34px);
                    bgr := Rectangle { background: cb.has-hover ? #3d3d3d : #262626; border-radius: 4px; }
                    cont-lbl := Text {
                        text: root.container-label;
                        color: #dddddd;
                        x: 8px;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                    arrow := Text {
                        text: "▾";
                        color: #999999;
                        x: parent.width - 18px;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                    cb := TouchArea { clicked => { root.open-manager(); } }
                }

                // browsing history (task: browsing history) — the rightmost
                // control of the top bar, right next to the container
                // dropdown; same house pattern as the menu buttons to its left
                MiniButton { icon: "hamburger"; clicked => { root.toggle-history-menu(); } }
            }
        }

        // ---- tab strip ----------------------------------------------------
        // Tabs share the bar instead of running off its right end: a tab takes
        // the width its title wants while there is room for every tab to have
        // that, and once there is not, every tab takes an even share of what the
        // bar has left and its title is elided to fit. Only when even a share
        // would come out narrower than the stripe, a badge and the ✕ do the tabs
        // stop shrinking and the Flickable pans the row. Nothing is hidden by
        // the ellipsis: hovering a tab hands its full title to the window's one
        // tooltip (task: tab strip fits the bar).
        stripr := Rectangle {
            height: 30px;
            background: #252525;

            Flickable {
                width: parent.width;
                height: parent.height;
                horizontal-stretch: 1000;
                viewport-width: Math.max(self.width, tab-row.width + 16px);

                tab-row := HorizontalLayout {
                    width: self.preferred-width;
                    spacing: 4px;
                    padding-left: 6px;
                    padding-top: 3px;

                    for tab[idx] in tabs: tabrect := Rectangle {
                        // What this tab would take if every tab were treated
                        // alike: the bar less its 6 px of left padding, the 16 px
                        // of slack the Flickable adds to its viewport (and
                        // centers the row in, so a row that claims the whole bar
                        // hangs 8 px over the end) and the 4 px gaps between
                        // neighbours, split evenly. Measured off the bar, never
                        // off the row — the row is exactly as wide as its tabs
                        // are, which is the thing being solved for.
                        property <length> share: (stripr.width - 22px - 4px * Math.max(0, tabs.length - 1)) / Math.max(1, tabs.length);
                        // Stripe + badge + ✕ + at least a syllable of title:
                        // the point below which squeezing turns a tab into a
                        // glyph, so the row overflows and scrolls instead.
                        property <length> squeeze-floor: tab.shortcut == "" ? 74px : 92px;
                        height: 24px;
                        width: Math.max(self.squeeze-floor, Math.min(Math.min(220px, Math.max(90px, tt.preferred-width + (tab.shortcut == "" ? 44px : 61px))), self.share));
                        tbgr := Rectangle {
                            background: tab.active ? #3a3a3a : #2e2e2e;
                            border-radius: 4px;
                        }
                        // container-colored stripe
                        stripe := Rectangle {
                            x: 6px;
                            width: 5px;
                            y: 4px;
                            height: parent.height - 8px;
                            border-radius: 2px;
                            background: tab.color;
                        }
                        // Alt-digit badge: which Alt-N lands here today. It is
                        // re-rendered from the tab order on every snapshot, so
                        // opening/closing tabs moves the numbers by itself.
                        alt := Text {
                            text: tab.shortcut;
                            color: tab.active ? #c8c8c8 : #7a7a7a;
                            x: 15px;
                            width: 14px;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                        }
                        // A `max-width` leaves a Text its full preferred width
                        // in this layout (measured, not guessed), so the title
                        // is told how wide it is: everything past the tab's own
                        // edge — stripe and badge on the left, the ✕ on the
                        // right — is an ellipsis, never a word drawn over the
                        // neighbour.
                        tt := Text {
                            text: tab.title == "" ? "New Tab" : tab.title;
                            color: tab.active ? #f0f0f0 : #999999;
                            x: tab.shortcut == "" ? 16px : 33px;
                            width: Math.max(0px, parent.width - (tab.shortcut == "" ? 40px : 57px));
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        // The title in full, for the hover tooltip: exactly the
                        // string `tt` may have shortened.
                        property <string> full-title: tab.title == "" ? "New Tab" : tab.title;
                        xbtn := Text {
                            text: "×";
                            color: xt.has-hover ? #ffffff : #888888;
                            x: parent.width - 20px;
                            vertical-alignment: center;
                        }
                        // tabta declared before the ✕ ⇒ bottom z-order: the
                        // tab activates on click; ✕zone (declared last, top,
                        // sized to the glyph only — a bare TouchArea would
                        // fill the whole tab) closes it instead
                        tabta := TouchArea {
                            clicked => { root.activate-tab(idx); }
                            // Same house rule as the toolbar buttons: the hover
                            // is reported and the window's single overlay draws
                            // it (a tooltip inside the tab would be a descendant
                            // of the strip and paint under the page). The ✕ sits
                            // on top with its own zone, so pointing at it asks
                            // nothing of the title.
                            changed has-hover => {
                                if (tabta.has-hover) {
                                    root.tip-text = tabrect.full-title;
                                    root.tip-x = tabrect.absolute-position.x;
                                    root.tip-y = tabrect.absolute-position.y + tabrect.height + 6px;
                                    root.tip-on = true;
                                } else {
                                    root.tip-on = false;
                                    root.tip-text = "";
                                }
                            }
                        }
                        xzone := Rectangle {
                            x: parent.width - 24px;
                            width: 20px;
                            height: parent.height;
                            xt := TouchArea {
                                clicked => { root.close-tab(idx); }
                            }
                        }
                    }
                }
            }
        }

        // ---- page ----------------------------------------------------------
        page := PageSurface {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            focus-token: root.focus-page-token;
            key(pressed, txt, ctrl, shift, alt, meta, repeat) => {
                root.page-key(pressed, txt, ctrl, shift, alt, meta, repeat);
            }

            page-frame := Rectangle {
                x: 0; y: 0;
                width: parent.width; height: parent.height;
                background: #ffffff;

                Image {
                    source: root.page-image;
                    width: parent.width;
                    height: parent.height;
                    image-fit: fill;
                }

                ta := TouchArea {
                    // the page's pointer shape (task: cursor icon)
                    mouse-cursor: root.page-cursor;
                    // clicking the page returns keyboard focus to it
                    changed pressed => { if (ta.pressed) { root.focus-page-token += 1; } }
                    pointer-event(ev) => {
                        // kind: 0 move, 1 down, 2 up, 4 out (`let` is immutable:
                        // derive with ternaries; coords come from the TouchArea)
                        let kind = ev.kind == PointerEventKind.down ? 1 : ev.kind == PointerEventKind.up ? 2 : ev.kind == PointerEventKind.cancel ? 4 : 0;
                        let btn = ev.button == PointerEventButton.right ? 1 : ev.button == PointerEventButton.middle ? 2 : 0;
                        root.page-pointer(ta.mouse-x, ta.mouse-y, kind, btn,
                            ev.modifiers.control, ev.modifiers.shift, ev.modifiers.alt, ev.modifiers.meta);
                    }
                    // Slint hands over winit's wheel deltas untouched, and the
                    // tab's engine (blitz) consumes that very convention
                    // (positive delta = wheel UP / content moves down-right),
                    // so forward them verbatim — negating here inverted the wheel.
                    scroll-event(ev) => {
                        root.page-wheel(ta.mouse-x, ta.mouse-y, ev.delta-x, ev.delta-y);
                        return EventResult.accept;
                    }
                }

                // ---- overlay scroll bar ---------------------------------------
                //
                // Declared after the page's `ta` ⇒ it draws on top of the
                // document, and before the DevTools panel, the menus and the
                // dialog ⇒ they draw on top of it (task: scroll bar). Inset and
                // thickness belong here (the bar hugs the edge whatever the
                // window does); only the thumb's place is Rust's, and only the
                // one bool decides whether it is up at all.
                //
                // A plain Rectangle with no TouchArea: a click that lands on the
                // thumb reaches the page underneath it, exactly as it did before
                // the bar existed, and the `ta` above still gets every wheel.
                Rectangle {
                    x: parent.width - 12px;
                    width: 10px;
                    y: root.scrollbar-thumb-y;
                    height: root.scrollbar-thumb-height;
                    opacity: root.scrollbar-visible ? 1.0 : 0.0;
                    animate opacity { duration: 300ms; }
                    Rectangle {
                        border-radius: 5px;
                        // Mid grey with a hairline dark edge: legible over a
                        // white page and over a dark one, which is all a
                        // two-second overlay can ask for.
                        background: #8f8f8fe0;
                        border-width: 1px;
                        border-color: #00000040;
                    }
                }

                // ---- DevTools panel -----------------------------------------
                // Bottom-docked over the page frame, and — exactly like the
                // context menu and the container manager — an in-window
                // overlay Rectangle, not a PopupWindow (the LinuxKMS backend
                // has no popups). Declared after the page's `ta` ⇒ on top of
                // it: the scrim swallows page clicks and wheel events while
                // the panel is open, and the ListView scrolls instead.
                dt-panel := Rectangle {
                    visible: root.devtools-open;
                    x: 0;
                    y: parent.height - self.height;
                    width: parent.width;
                    // The height Rust holds for this tab — see `devtools-height`.
                    // It is a number, not a share, because the reader set it by
                    // dragging and a share would move it under their hand every
                    // time the window did.
                    height: root.devtools-height;
                    background: #171717;
                    clip: true;
                    dt-scrim := TouchArea { }
                    // separator from the page above — and the line the reader
                    // grabs to resize the panel (`dt-edge`, declared after the
                    // panel, lies exactly over it)
                    Rectangle { x: 0; y: 0; width: parent.width; height: 1px; background: #4a4a4a; }

                    VerticalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-bottom: 6px;
                        spacing: 4px;

                        // ---- header: pane buttons (with entry counts) + close
                        Rectangle {
                            height: 32px;
                            HorizontalLayout {
                                x: 0; width: parent.width; height: parent.height;
                                cross-axis-alignment: center;
                                spacing: 6px;
                                MiniButton {
                                    label: "Console" + (root.console-count > 0 ? " " + root.console-count : "");
                                    tint: root.devtools-view == 0 ? #3a3a3a : #262626;
                                    clicked => { root.devtools-select-view(0); }
                                }
                                MiniButton {
                                    label: "Network" + (root.network-count > 0 ? " " + root.network-count : "");
                                    tint: root.devtools-view == 1 ? #3a3a3a : #262626;
                                    clicked => { root.devtools-select-view(1); }
                                }
                                MiniButton {
                                    label: "Inspector" + (root.inspector-count > 0 ? " " + root.inspector-count : "");
                                    tint: root.devtools-view == 2 ? #3a3a3a : #262626;
                                    // a tree the tab had to cut short is said here too
                                    opacity: root.inspector-truncated ? 0.55 : 1.0;
                                    clicked => { root.devtools-select-view(2); }
                                }
                                // ⌖ *inspect element*: armed for the whole tab, so the
                                // button stays lit while the page swallows pointers for
                                // the picker (Ctrl-Shift-C is the same chord).
                                MiniButton {
                                    label: "";
                                    icon: "crosshair";
                                    tint: root.inspector-pick ? #7a4a1d : #262626;
                                    clicked => { root.devtools-toggle-pick(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                MiniButton {
                                    label: "Clear";
                                    // Console / Network feeds only: the Inspector pane
                                    // has no feed of its own, its tree is the document.
                                    enabled: root.devtools-view != 2;
                                    clicked => { root.devtools-clear(); }
                                }
                                MiniButton {
                                    label: "Copy";
                                    // What the pane has highlighted: a marked
                                    // Console/Network row, or the selected node
                                    // (its subtree's HTML) on the Inspector.
                                    enabled: root.devtools-copy-available;
                                    clicked => { root.devtools-copy(); }
                                }
                                MiniButton { label: "×"; clicked => { root.devtools-close(); } }
                            }
                        }

                        // ---- console view -------------------------------------
                        if root.devtools-view == 0: ListView {
                            vertical-stretch: 1;
                            for dtc[i] in root.console-rows: Rectangle {
                                height: 22px;
                                dtcbg := Rectangle { background: dtc.selected ? #33260f : dtcta.has-hover ? #262626 : Math.mod(i, 2) == 0 ? transparent : #1b1b1b; }
                                Text {
                                    x: 8px;
                                    width: 18px;
                                    height: parent.height;
                                    text: root.devtools-level-icon(dtc.level);
                                    color: root.devtools-level-color(dtc.level);
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                Text {
                                    x: 30px;
                                    max-width: Math.max(0px, parent.width - 38px);
                                    height: parent.height;
                                    text: dtc.text;
                                    color: root.devtools-level-color(dtc.level);
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                // Click marks the row for `Copy`; double-click
                                // marks it and copies the whole line at once.
                                dtcta := TouchArea {
                                    clicked => { root.devtools-select-row(0, i); }
                                    double-clicked => { root.devtools-copy-row(0, i); }
                                }
                            }
                        }

                        // ---- network view --------------------------------------
                        if root.devtools-view == 1: VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 2px;
                            // column captions
                            Rectangle {
                                height: 20px;
                                head := NetRowCells {
                                    width: parent.width;
                                    height: parent.height;
                                    cell-color: #8a8a8a;
                                    method: "Method";
                                    url: "URL";
                                    initiator: "Initiator";
                                    status: "Status";
                                    bytes: "Size";
                                    time: "Time";
                                }
                            }
                            ListView {
                                vertical-stretch: 1;
                                for dtn[i] in root.net-rows: Rectangle {
                                    height: 22px;
                                    net-row-bg := Rectangle { background: dtn.selected ? #33260f : netrowta.has-hover ? #262626 : Math.mod(i, 2) == 0 ? transparent : #1b1b1b; }
                                    NetRowCells {
                                        x: 0; y: 0;
                                        width: parent.width;
                                        height: parent.height;
                                        method: dtn.method;
                                        url: dtn.url;
                                        initiator: dtn.initiator;
                                        status: dtn.status;
                                        bytes: dtn.size;
                                        time: dtn.time;
                                        cell-color: dtn.failed ? #ef5350 : #cfcfcf;
                                        status-color: dtn.failed ? #ef5350 : #cfcfcf;
                                    }
                                    // Same gestures as the console rows:
                                    // click marks, double-click copies the row.
                                    netrowta := TouchArea {
                                        clicked => { root.devtools-select-row(1, i); }
                                        double-clicked => { root.devtools-copy-row(1, i); }
                                    }
                                }
                            }
                        }

                        // ---- Inspector view ------------------------------------
                        // Breadcrumb over the tree: `html › body › div#main`, the
                        // selected node's ancestor chain, every crumb clickable.
                        if root.devtools-view == 2: VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 2px;
                            Rectangle {
                                height: 18px;
                                Text {
                                    x: 2px; width: parent.width; height: parent.height;
                                    text: root.inspector-summary;
                                    color: #8a8a8a; font-size: 12px;
                                    vertical-alignment: center; overflow: elide;
                                }
                            }
                            Rectangle {
                                height: root.inspector-crumb.length > 0 ? 22px : 0px;
                                HorizontalLayout {
                                    spacing: 3px;
                                    cross-axis-alignment: center;
                                    for ci[i] in root.inspector-crumb: Rectangle {
                                        width: crumb-inner.preferred-width + 8px;
                                        height: 20px;
                                        border-radius: 3px;
                                        crumb-bg := Rectangle {
                                            background: crumb-ta.has-hover ? #3a3a3a : transparent;
                                            border-radius: 3px;
                                        }
                                        crumb-inner := HorizontalLayout {
                                            padding-left: 3px; padding-right: 3px;
                                            spacing: 0px;
                                            Text {
                                                text: i > 0 ? "› " : "";
                                                color: #6a6a6a;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: ci.tag;
                                                color: root.inspect-kind-color(1);
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: ci.ident;
                                                color: root.inspect-kind-color(8);
                                                vertical-alignment: center;
                                            }
                                        }
                                        crumb-ta := TouchArea {
                                            clicked => { root.devtools-select-node(ci.node); }
                                        }
                                    }
                                }
                            }
                            // The tree, or the reason there is none.
                            if root.inspector-empty: Rectangle {
                                height: 22px;
                                Text {
                                    x: 8px; width: parent.width; height: parent.height;
                                    text: root.inspector-hint;
                                    color: #6a6a6a; font-italic: true;
                                    vertical-alignment: center; overflow: elide;
                                }
                            }
                            if !root.inspector-empty: Rectangle {
                                vertical-stretch: 1;
                                insp-tree := ListView {
                                    x: 0px; y: 0px; width: parent.width; height: parent.height;
                                    for dr[i] in root.inspector-rows: Rectangle {
                                        height: 22px;
                                        dr-bg := Rectangle {
                                            background: dr-ta.has-hover ? #262626
                                                      : dr.selected ? #33260f
                                                      : Math.mod(i, 2) == 0 ? transparent : #1b1b1b;
                                        }
                                        // the row itself selects the node; the twisty is
                                        // declared above it and keeps its own click
                                        dr-ta := TouchArea {
                                            clicked => { root.devtools-select-node(dr.node); }
                                            // Double-click copies that node: an
                                            // element yields its subtree's HTML
                                            // (task: copy in the DevTools tabs).
                                            double-clicked => { root.devtools-copy-row(2, dr.node); }
                                        }
                                        dr-tw := TouchArea {
                                            x: 6px + dr.depth * 12px;
                                            width: 16px;
                                            height: parent.height;
                                            visible: dr.twisty != "";
                                            clicked => { root.devtools-toggle-fold(dr.node); }
                                        }
                                        Text {
                                            x: 6px + dr.depth * 12px;
                                            width: 16px; height: parent.height;
                                            text: dr.twisty;
                                            color: #9a9a9a;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        // Tokens run end to end into one markup string. A
                                        // Text in a layout has no upper width bound, so with
                                        // nothing else asking for the leftover, a wide row
                                        // splits that leftover *equally over every token*
                                        // and the markup reads `<   div   >`. The stretchy
                                        // tail claims the rest of the row; and only the last
                                        // token may elide, so an over-long row truncates at
                                        // its tail instead of every token becoming `…`.
                                        dr-toks := HorizontalLayout {
                                            x: 22px + dr.depth * 12px;
                                            width: Math.max(0px, parent.width - 22px - dr.depth * 12px);
                                            height: parent.height;
                                            spacing: 0px;
                                            for dt[i] in dr.toks: dr-tok := Text {
                                                text: dt.text;
                                                color: root.inspect-kind-color(dt.kind);
                                                font-italic: dr.italic;
                                                vertical-alignment: center;
                                                overflow: i == dr.toks.length - 1 ? elide : clip;
                                            }
                                            dr-tail := Rectangle { horizontal-stretch: 1; }
                                        }
                                    }
                                }

                                // …and the thing that takes the reader to a
                                // selection made on the page: it names the tree
                                // above as its sibling. `viewport-y` is written,
                                // never bound, so the wheel owns the tree again
                                // afterwards.
                                InspectorReveal {
                                    width: 0px;
                                    height: 0px;
                                    reveal-row: root.inspector-reveal-row;
                                    token: root.inspector-reveal-token;
                                    window-height: insp-tree.height;
                                    content-height: insp-tree.viewport-height;

                                    shown-from: -insp-tree.viewport-y;
                                    scrolled(offset) => {
                                        insp-tree.viewport-y = offset;
                                    }
                                    observed(offset) => {
                                        root.inspector-shown-from = offset;
                                    }
                                }
                            }
                            // A snapshot the tab had to cut short says so, dim, last.
                            Rectangle {
                                height: root.inspector-truncated ? 20px : 0px;
                                Text {
                                    x: 8px; width: parent.width; height: parent.height;
                                    text: "\u{2026} the tree is bigger than the tab can send";
                                    color: #6a6a6a; font-italic: true;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // ---- panel resize handle ----------------------------------
                // The DevTools panel's top edge, draggable: hold it and pull the
                // panel up to make it taller, push it down to make it shorter.
                // The strip straddles the edge — 4 px of page above (where the
                // panel has nothing of its own to steal a click from) and 4 px of
                // its own separator band, which stops exactly where the header
                // buttons begin — and being declared after the panel puts it
                // above the panel's scrim, so it gets the press.
                //
                // `pressed-y - mouse-y` is the pointer's travel since the grab:
                // a TouchArea is handed every move while it holds the pointer,
                // even ones long outside itself, and the panel that grows and
                // shrinks underneath carries the strip along with it. Measuring
                // from the press instead of from the last move is what lets Rust
                // clamp at a floor or ceiling without the pointer's travel
                // leaking into a drift; see `devtools-edge`.
                dt-edge := Rectangle {
                    x: 0px;
                    y: dt-panel.y - 4px;
                    width: parent.width;
                    height: 8px;
                    visible: root.devtools-open;
                    // Where the grab happened, in the *page area's* frame. This
                    // strip rides the panel up as the panel grows, so travel read
                    // off the strip's own frame loses exactly the height the drag
                    // has won so far and the panel follows at half the pointer's
                    // speed; adding the strip's own y back in measures the drag in
                    // a frame that does not move, which is the only frame a drag
                    // can be measured in.
                    property <length> grab-y: 0px;
                    dt-edge-ta := TouchArea {
                        mouse-cursor: dt-edge-ta.pressed ? MouseCursor.grabbing : MouseCursor.ns-resize;
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.down) {
                                dt-edge.grab-y = dt-edge.y + dt-edge-ta.mouse-y;
                                root.devtools-edge(0, 0px);
                            } else if (ev.kind == PointerEventKind.move && dt-edge-ta.pressed) {
                                root.devtools-edge(1, dt-edge.grab-y - (dt-edge.y + dt-edge-ta.mouse-y));
                            } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                                root.devtools-edge(2, 0px);
                            }
                        }
                    }
                }

                // ---- context menu -----------------------------------------
                // An in-page overlay, not a PopupWindow: the LinuxKMS backend
                // has no popups, so — exactly like the container manager —
                // the menu is drawn on top of the page frame. Declared after
                // `ta` ⇒ on top of it: the scrim swallows page clicks while
                // the menu is open, and every item row (declared later than
                // the scrim) keeps its own click.
                Rectangle {
                    visible: root.menu-open;
                    x: 0; y: 0;
                    width: parent.width; height: parent.height;
                    menu-scrim := TouchArea {
                        clicked => { root.menu-close(); }
                    }
                    Rectangle {
                        x: Math.max(2px, Math.min(root.menu-x, parent.width - self.width - 2px));
                        y: Math.max(2px, Math.min(root.menu-y, parent.height - self.height - 2px));
                        width: 232px;
                        height: menu-list.preferred-height + 10px;
                        background: #2a2a2a;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #4a4a4a;
                        menu-list := VerticalLayout {
                            padding: 4px;
                            spacing: 1px;
                            for mi[i] in root.menu-items: Rectangle {
                                height: 26px;
                                mibgr := Rectangle {
                                    background: mita.has-hover ? #3d3d3d : transparent;
                                    border-radius: 4px;
                                }
                                mitxt := Text {
                                    text: mi.label;
                                    color: #e8e8e8;
                                    x: 10px;
                                    vertical-alignment: center;
                                    max-width: parent.width - 18px;
                                    overflow: elide;
                                }
                                mita := TouchArea {
                                    clicked => { root.menu-pick(i); }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ---- status bar ------------------------------------------------------
        Rectangle {
            height: 24px;
            background: #2b2b2b;

            // ---- loading progress bar -----------------------------------------
            // Website loading progress, left-hand end of the status bar: a
            // recessed track with a brighter segment sweeping across it while
            // the active tab loads. The tab protocol reports loading as a
            // single bool (no byte counts), so the progress is honestly
            // indeterminate — the sweep *is* the progress.
            //
            // The rects sit *outside* the layout below, pinned to the track:
            // a layout gives its items no geometry until they have content,
            // and an always-empty Rectangle must never push the spinner text
            // off the left edge.
            load-track := Rectangle {
                x: 10px;
                y: (parent.height - self.height) / 2;
                width: 96px;
                height: 4px;
                visible: root.loading;
                border-radius: 2px;
                background: #3a3a3a;

                // The lit segment: a fixed-size (a quarter of the track)
                // window sliding from the left end to the right end and back.
                load-segment := Rectangle {
                    // 12 steps × 4 px = the 96 px track; the track's own
                    // border-radius keeps the segment's corners round when it
                    // sits at either end.
                    x: root.load-progress * 4px;
                    width: Math.min(24px, parent.width - root.load-progress * 4px);
                    height: parent.height;
                    background: #5b9dd9;
                    border-radius: 2px;
                }
            }

            HorizontalLayout {
                x: 10px;
                height: parent.height;
                cross-axis-alignment: center;
                spacing: 8px;

                // The bar owns the left edge: while it is up the text column
                // starts after it instead of under it.
                Rectangle { width: root.loading ? 106px : 0px; height: 1px; }
                Text { text: root.spinner; color: #bbbbbb; }
                Text { text: root.sec-glyph; color: root.sec-color; }
                st := Text {
                    text: root.status-text;
                    color: #aaaaaa;
                    vertical-alignment: center;
                    max-width: Math.max(0px, root.width - 220px);
                    overflow: elide;
                }
            }
        }
    }

    // ------------------------------------------------------------------------
    // JS dialog overlay (window.alert / confirm / prompt)
    //
    // An in-window overlay like the manager and the context menu (LinuxKMS
    // has no popups), declared after the page ⇒ above every page overlay
    // including the DevTools panel: while a dialog is open its scrim
    // swallows every click on the page, matching a real modal — and the tab
    // process is blocked on the answer anyway, so the page cannot act.
    // ------------------------------------------------------------------------
    Rectangle {
        x: 0; y: 0;
        width: root.width; height: root.height;
        visible: root.dialog-open;
        background: #00000066;
        dialog-scrim := TouchArea { }

        dialog-panel := Rectangle {
            x: (root.width - self.width) / 2;
            y: Math.max(24px, (root.height - self.height) / 2);
            width: Math.min(440px, root.width - 48px);
            height: dialog-body.preferred-height + 36px;
            background: #242424;
            border-radius: 8px;
            border-width: 1px;
            border-color: #565656;
            // clicks on the panel itself must not fall through to the scrim
            panel-ta := TouchArea { }

            dialog-body := VerticalLayout {
                padding: 16px;
                spacing: 10px;

                Text {
                    text: root.dialog-title;
                    color: #a8b8c8;
                    font-size: 12px;
                }
                Text {
                    text: root.dialog-message;
                    color: #ececec;
                    wrap: word-wrap;
                    horizontal-alignment: left;
                }
                if root.dialog-kind == 2: LineEdit {
                    text <=> root.dialog-input;
                    placeholder-text: "Enter text";
                    accepted => { root.dialog-accept(); }
                }
                Rectangle {
                    height: 28px;
                    HorizontalLayout {
                        x: 0; width: parent.width; height: parent.height;
                        spacing: 8px;
                        alignment: end;
                        MiniButton { label: "Cancel"; visible: root.dialog-kind != 0; clicked => { root.dialog-cancel(); } }
                        MiniButton { label: "OK"; clicked => { root.dialog-accept(); } }
                    }
                }
            }
        }
    }

    // ------------------------------------------------------------------------
    // find-in-page bar (Ctrl-F): floats over the top-right corner of the page,
    // declared after the page ⇒ above it (and above the DevTools panel), but
    // before the modal overlays, which must keep covering everything.
    // ------------------------------------------------------------------------
    find-bar := FindBar {
        x: page-frame.absolute-position.x + page-frame.width - self.width - 16px;
        y: page-frame.absolute-position.y + 8px;
        visible: root.find-open;
        focus-token: root.find-focus-token;
        count: root.find-count;
        text <=> root.find-text;
        query-changed(q) => { root.find-query-changed(q); }
        next() => { root.find-next(); }
        previous() => { root.find-previous(); }
        close() => { root.find-close(); }
        chord(t, c, s, a, m) => { return root.find-chord(t, c, s, a, m); }
    }

    // ------------------------------------------------------------------------
    // container manager overlay
    // ------------------------------------------------------------------------
    Rectangle {
        x: 0; y: 0;
        width: root.width; height: root.height;
        visible: root.manager-open;
        background: #00000099;
        scrim := TouchArea { clicked => { root.close-manager(); } }

        panel := Rectangle {
            TouchArea {} // swallow clicks over the panel
            x: root.width - self.width;
            width: Math.min(380px, root.width);
            height: root.height;
            background: #1e1e1e;

            VerticalLayout {
                padding: 12px;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 8px;
                    height: 26px;
                    Text { text: "Containers"; color: #f0f0f0; font-weight: 600; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    MiniButton { label: "×"; clicked => { root.close-manager(); } }
                }

                for c[i] in containers: Rectangle {
                    height: 54px;
                    width: parent.width;
                    sel := Rectangle { background: i == root.selected-container ? #383838 : #262626; border-radius: 4px; }
                    // declared before the content ⇒ bottom z-order: clicking
                    // anywhere on the row still selects it, but the New/Move
                    // tab/Delete/Ren buttons (declared on top) keep receiving
                    // their clicks — a TouchArea declared last swallowed all
                    // of them, which is why "New" only ever re-selected.
                    selta := TouchArea { clicked => { root.mgr-select(i); } }
                    VerticalLayout {
                        x: 6px; y: 3px;
                        width: parent.width - 12px;
                        spacing: 2px;
                        HorizontalLayout {
                            height: 22px;
                            spacing: 6px;
                            Rectangle { width: 12px; height: 12px; border-radius: 3px; background: c.color; }
                            if i == root.editing-index: LineEdit {
                                horizontal-stretch: 1;
                                text: root.container-edit-text;
                                edited(t) => { root.container-edit-text = t; }
                                accepted => { root.mgr-rename(i); }
                            }
                            Text {
                                visible: i != root.editing-index;
                                text: c.name + (c.isDefault ? " ★" : "")
                                    + (c.proxy != "" ? " · " + c.proxy : "")
                                    + (c.private ? " · private" : "");
                                color: #e8e8e8;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            MiniButton { visible: i != root.editing-index; label: "Ren"; clicked => { root.mgr-start-rename(i); } }
                            MiniButton { visible: i == root.editing-index; label: "OK"; clicked => { root.mgr-rename(i); } }
                        }
                        HorizontalLayout {
                            height: 22px;
                            spacing: 6px;
                            // Private browsing (task): one checkbox per
                            // container row — DNT on for its tabs, no visits
                            // in the shared history, and the top-bar badge
                            // lights when such a tab is on screen. First in
                            // the row, deliberately: the buttons behind it
                            // are what overflow a narrow panel, never the
                            // toggle (a trailing checkbox ran off the
                            // window's edge).
                            CheckBox {
                                text: "Private";
                                checked: c.private;
                                toggled => { root.mgr-toggle-private(i); }
                            }
                            MiniButton { label: "New"; clicked => { root.mgr-new-tab-in(i); } }
                            MiniButton { label: "Move tab"; clicked => { root.mgr-move-tab-to(i); } }
                            MiniButton {
                                label: "Delete";
                                enabled: !c.isDefault;
                                clicked => { root.mgr-delete(i); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }

                Text { text: "Add container"; color: #f0f0f0; }
                HorizontalLayout {
                    height: 26px;
                    spacing: 6px;
                    LineEdit {
                        horizontal-stretch: 1;
                        text: root.container-edit-text;
                        edited(t) => { root.container-edit-text = t; }
                        placeholder-text: "name";
                        accepted => { root.mgr-add(); }
                    }
                    MiniButton { label: "Add"; clicked => { root.mgr-add(); } }
                }
                HorizontalLayout {
                    height: 20px;
                    spacing: 6px;
                    for p in [0, 1, 2, 3, 4, 5, 6]: Rectangle {
                        width: 18px; height: 18px; border-radius: 4px;
                        background: root.palette-color(p);
                        pt := TouchArea { clicked => { root.mgr-recolor(root.selected-container, p); } }
                    }
                }

                Rectangle { vertical-stretch: 1; }
                Text {
                    text: "Move tab re-spawns the active tab in the selected container (keeping its URL). Delete wipes that container's data. The palette recolors the selected container.";
                    color: #888888;
                    wrap: word-wrap;
                }
            }
        }
    }

    // ------------------------------------------------------------------------
    // userscript menu overlay (task: userscript menu)
    //
    // Exactly like the container manager above and never a PopupWindow (LinuxKMS
    // has no popups): a right-docked Rectangle over everything, its scrim a
    // TouchArea that closes the menu. Declared last ⇒ on top of the manager too
    // — and Rust closes one when the other opens, so they never stack.
    // ------------------------------------------------------------------------
    Rectangle {
        x: 0; y: 0;
        width: root.width; height: root.height;
        visible: root.us-menu-open;
        background: #00000099;
        us-scrim := TouchArea { clicked => { root.close-us-menu(); } }

        us-panel := Rectangle {
            TouchArea {} // swallow clicks over the panel
            x: root.width - self.width;
            width: Math.min(420px, root.width);
            height: root.height;
            background: #1e1e1e;

            VerticalLayout {
                padding: 12px;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 8px;
                    height: 26px;
                    Text { text: "Userscripts"; color: #f0f0f0; font-weight: 600; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    MiniButton { label: "×"; clicked => { root.close-us-menu(); } }
                }

                // one-line validation feedback (a failed Save keeps the editor up)
                Text {
                    visible: root.us-error != "";
                    text: root.us-error;
                    color: #ef5350;
                    wrap: word-wrap;
                }

                for us[i] in root.us-scripts: Rectangle {
                    height: 44px;
                    width: parent.width;
                    usbg := Rectangle { background: usa.has-hover ? #2c2c2c : #262626; border-radius: 4px; }
                    // declared before the content ⇒ bottom z-order: the row still
                    // highlights on hover, but the CheckBox and ✕ (declared on top)
                    // receive their clicks — a TouchArea declared last swallowed all
                    // of them, so toggling and deleting did nothing (same trap the
                    // container-manager rows above already fell into).
                    // Clicking anywhere else on the row edits the script: the
                    // text/layout items above are click-transparent, so their
                    // clicks land here and round-trip to `us-edit(idx)`.
                    usa := TouchArea {
                        clicked => { root.us-edit(i); }
                    }
                    HorizontalLayout {
                        x: 6px; y: 3px;
                        width: parent.width - 12px;
                        spacing: 8px;
                        cross-axis-alignment: center;
                        // the enable/disable toggle, bound to the stored flag;
                        // Rust persists through the Store at once and re-broadcasts
                        CheckBox {
                            checked: us.enabled;
                            toggled => { root.us-toggle(i); }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 0px;
                            Text {
                                text: us.name;
                                color: #e8e8e8;
                                font-weight: 600;
                                horizontal-alignment: left;
                                overflow: elide;
                            }
                            Text {
                                text: us.patterns;
                                color: #8a8a8a;
                                font-size: 11px;
                                horizontal-alignment: left;
                                overflow: elide;
                            }
                        }
                        MiniButton { label: "×"; clicked => { root.us-delete(i); } }
                    }
                }

                if root.us-scripts.length == 0 && !root.us-editing: Text {
                    text: "No userscripts yet — add one below. Enabled scripts run on matching pages; disabled ones are never sent to a tab.";
                    color: #888888;
                    wrap: word-wrap;
                }

                Rectangle { vertical-stretch: 1; }

                // ---- footer: "+ New script" and the inline editor ----------
                if !root.us-editing: HorizontalLayout {
                    height: 28px;
                    spacing: 6px;
                    MiniButton { label: "+ New script"; clicked => { root.us-new(); } }
                }
                if root.us-editing: VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: root.us-editing-existing ? "Edit userscript" : "New userscript";
                        color: #f0f0f0;
                        font-weight: 600;
                    }
                    LineEdit {
                        height: 26px;
                        text <=> root.us-name;
                        placeholder-text: "name";
                    }
                    LineEdit {
                        height: 26px;
                        text <=> root.us-patterns;
                        placeholder-text: "URL patterns (comma or space separated, * wildcards ok)";
                    }
                    // multi-line code editor: the builtin TextInput with
                    // single-line off (a LineEdit would flatten the script)
                    Rectangle {
                        height: Math.min(160px, Math.max(120px, parent.width * 0.35));
                        background: #141414;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #3a3a3a;
                        clip: true;
                        us-code-focus := FocusScope {
                            width: parent.width; height: parent.height;
                            TextInput {
                                width: parent.width;
                                height: parent.height;
                                single-line: false;
                                wrap: word-wrap;
                                font-size: 12px;
                                color: #e8e8e8;
                                text <=> root.us-code;
                            }
                        }
                    }
                    HorizontalLayout {
                        height: 28px;
                        spacing: 8px;
                        MiniButton { label: "Save"; clicked => { root.us-save(); } }
                        MiniButton { label: "Cancel"; clicked => { root.us-cancel(); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
        }
    }

    // ------------------------------------------------------------------------
    // User-Agent switcher overlay (task: per-container UA)
    //
    // Exactly like the userscript menu above and the container manager before
    // it — a right-docked Rectangle (never a PopupWindow: LinuxKMS has none),
    // its scrim a TouchArea that closes the menu. Declared last ⇒ on top of
    // both; Rust closes those when this opens (and vice versa), so no two of
    // the three ever stack. The menu targets the *active tab's container*.
    // ------------------------------------------------------------------------
    Rectangle {
        x: 0; y: 0;
        width: root.width; height: root.height;
        visible: root.ua-menu-open;
        background: #00000099;
        ua-scrim := TouchArea { clicked => { root.close-ua-menu(); } }

        ua-panel := Rectangle {
            TouchArea {} // swallow clicks over the panel
            x: root.width - self.width;
            width: Math.min(420px, root.width);
            height: root.height;
            background: #1e1e1e;

            VerticalLayout {
                padding: 12px;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 8px;
                    height: 26px;
                    Text { text: "User-Agent"; color: #f0f0f0; font-weight: 600; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    MiniButton { label: "×"; clicked => { root.close-ua-menu(); } }
                }

                // the container's live value ("Default (IronSurf)" / a preset
                // name / "Custom"), re-pushed after every mutation
                Text {
                    text: "Current: " + root.ua-current;
                    color: #a8b8c8;
                    wrap: word-wrap;
                }

                // one-line validation feedback (a rejected Apply keeps the draft)
                Text {
                    visible: root.ua-error != "";
                    text: root.ua-error;
                    color: #ef5350;
                    wrap: word-wrap;
                }

                for ua[i] in root.ua-rows: Rectangle {
                    height: 26px;
                    width: parent.width;
                    // the active row is highlighted; declared before the text
                    // ⇒ bottom z-order, so its TouchArea still receives the
                    // click the layout above lets through (the trap the
                    // container-manager and userscript rows already fell into).
                    uabg := Rectangle {
                        background: ua.active ? #3a3a3a : uata.has-hover ? #2c2c2c : #262626;
                        border-radius: 4px;
                    }
                    uata := TouchArea {
                        clicked => { root.ua-select(i); }
                    }
                    Text {
                        x: 10px;
                        max-width: parent.width - 32px;
                        height: parent.height;
                        text: ua.label + (ua.active ? "  ✓" : "");
                        color: ua.active ? #f0f0f0 : #c8c8c8;
                        font-weight: ua.active ? 600 : 400;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                Rectangle { vertical-stretch: 1; }

                // ---- footer: copy / restore / custom editor ---------------
                HorizontalLayout {
                    height: 28px;
                    spacing: 6px;
                    MiniButton { label: "Copy"; clicked => { root.ua-copy(); } }
                    MiniButton { label: "Restore default"; clicked => { root.ua-restore-default(); } }
                    Rectangle { horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    height: 28px;
                    spacing: 6px;
                    LineEdit {
                        horizontal-stretch: 1;
                        text <=> root.ua-custom;
                        placeholder-text: "custom User-Agent string";
                        accepted(t) => { root.ua-apply-custom(t); }
                    }
                    MiniButton { label: "Apply"; clicked => { root.ua-apply-custom(root.ua-custom); } }
                }
                Text {
                    text: "The choice is persisted for this container and sent to its live tabs; tabs in other containers keep their own User-Agent. New tabs of this container start with it.";
                    color: #888888;
                    wrap: word-wrap;
                }
            }
        }
    }

    // ------------------------------------------------------------------------
    // Archive-mode overlay (task: archive mode)
    //
    // The same right-docked Rectangle as the other three menus (never a
    // PopupWindow: LinuxKMS has none), opened by the 💾 toolbar button and
    // never stacked — Rust closes it when any other menu opens, and closes
    // the others when this one opens.
    // ------------------------------------------------------------------------
    Rectangle {
        x: 0; y: 0;
        width: root.width; height: root.height;
        visible: root.archive-menu-open;
        background: #00000099;
        archive-scrim := TouchArea { clicked => { root.close-archive-menu(); } }

        archive-panel := Rectangle {
            TouchArea {} // swallow clicks over the panel
            x: root.width - self.width;
            width: Math.min(420px, root.width);
            height: root.height;
            background: #1e1e1e;

            VerticalLayout {
                padding: 12px;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 8px;
                    height: 26px;
                    Text { text: "\u{1F4BE} Archive mode"; color: #f0f0f0; font-weight: 600; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    MiniButton { label: "×"; clicked => { root.close-archive-menu(); } }
                }

                CheckBox {
                    text: "Save every visited site and every file it loads";
                    checked <=> root.archive-enabled;
                    // `toggled` fires after the checkbox flipped `checked`,
                    // so the property already carries the wanted state.
                    toggled => { root.archive-set-enabled(root.archive-enabled); }
                }

                // one-line live status (effective root + files saved so far)
                Text {
                    text: root.archive-status;
                    color: #a8b8c8;
                    wrap: word-wrap;
                }

                // one-line validation feedback (a rejected Apply keeps the draft)
                Text {
                    visible: root.archive-error != "";
                    text: root.archive-error;
                    color: #ef5350;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    height: 28px;
                    spacing: 6px;
                    LineEdit {
                        horizontal-stretch: 1;
                        text <=> root.archive-dir-text;
                        placeholder-text: "archive folder (default: ~/Downloads/ironsurf-tabs)";
                        accepted(t) => { root.archive-apply-dir(t); }
                    }
                    MiniButton { label: "Apply"; clicked => { root.archive-apply-dir(root.archive-dir-text); } }
                }

                Rectangle { vertical-stretch: 1; }

                Text {
                    text: "While on, every page (saved as <host>/index.html), script, style, image, and media file the tabs load is written under <folder>/<timestamp of the tab's start>/<host>/… . Each tab process gets its own timestamp folder, so nothing an earlier run saved is ever overwritten by a later one. Folders are created on demand; failures are logged, never fatal.";
                    color: #888888;
                    wrap: word-wrap;
                }
            }
        }
    }

    // ------------------------------------------------------------------------
    // Settings drawer (task: browsing history)
    //
    // The same right-docked Rectangle as the other four menus (never a
    // PopupWindow: LinuxKMS has none), opened by the ☰ toolbar button and
    // never stacked — Rust closes it when any other menu opens, and closes
    // the others when this one opens. It is the browser's one settings spot,
    // and the visit log is **not** in it: the log is a page of its own
    // (`ironsurf://history`), which the History button opens in a new tab, so
    // this panel only counts the shared log and offers the two buttons.
    // Clear empties the whole shared log at once, from every container.
    // Below the history and scrolling settings sits the **proxy** section
    // (task: proxies) — the per-container route picker and the global
    // definition editor, moved here from a toolbar button of its own so the
    // top bar does not carry one more control. Opening the drawer re-pushes
    // that section's state, and a tab switch re-points it at the new
    // container's choice (the UA menu's rule).
    // ------------------------------------------------------------------------
    Rectangle {
        x: 0; y: 0;
        width: root.width; height: root.height;
        visible: root.history-menu-open;
        background: #00000099;
        history-scrim := TouchArea { clicked => { root.close-history-menu(); } }

        history-panel := Rectangle {
            TouchArea {} // swallow clicks over the panel
            x: root.width - self.width;
            width: Math.min(420px, root.width);
            height: root.height;
            background: #1e1e1e;

            VerticalLayout {
                padding: 12px;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 8px;
                    height: 26px;
                    Hamburger { width: 14px; height: 14px; tint: #f0f0f0; }
                    Text { text: "Settings"; color: #f0f0f0; font-weight: 600; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    MiniButton { label: "×"; clicked => { root.close-history-menu(); } }
                }

                // one-line summary (shared log: every container contributes)
                Text {
                    text: root.history-status;
                    color: #a8b8c8;
                    wrap: word-wrap;
                }

                // The visits themselves: a page of their own
                // (`ironsurf://history`), not a list inside the drawer.
                HorizontalLayout {
                    height: 28px;
                    spacing: 6px;
                    MiniButton { label: "History"; clicked => { root.history-page(); } }
                    MiniButton { label: "Clear history"; clicked => { root.history-clear(); } }
                    Rectangle { horizontal-stretch: 1; }
                }

                Text {
                    text: "History is shared by all containers: one visit in one container is listed (and can be cleared) from all of them, on the history page. Ctrl-Alt-T reopens the last closed tab.";
                    color: #888888;
                    wrap: word-wrap;
                }

                // The settings area (task: settings menu): this panel is the
                // browser's one settings spot, and the wheel's speed sits at
                // the bottom of it — a slider from a gentle 0.2× to a quick
                // 3×, stamped as a percentage of the default travel. Every
                // change applies browser-wide, persists, and survives a
                // restart; the tab side is `ToTab::SetScrollSpeed`.
                Rectangle { height: 1px; background: #3a3a3a; }
                HorizontalLayout {
                    spacing: 8px;
                    height: 24px;
                    Text { text: "Scrolling speed"; color: #f0f0f0; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: Math.round(root.scroll-speed * 100) + "%";
                        color: #a8b8c8;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    height: 26px;
                    speed-slider := Slider {
                        horizontal-stretch: 1;
                        minimum: 0.2;
                        maximum: 3.0;
                        step: 0.1;
                        value: root.scroll-speed;
                        changed(v) => { root.scroll-speed-set(v); }
                    }
                }

                // ---- Proxy (task: proxies) --------------------------------
                // The per-container route picker and the **global**
                // definition editor, housed here so the top bar needs no
                // button of its own. The rows target the *active tab's
                // container* (the UA menu's scoping rule): row 0 is
                // Direct, the rest are the global definitions, the
                // container's pick marked. A click stores the definition
                // **name** on the container and sends the resolved URL to
                // its live tabs; Del/Add edit the global pool and
                // re-resolve every live tab (a deleted definition strands
                // its containers — direct, name kept; re-adding it under
                // the same name reconnects them).
                Rectangle { height: 1px; background: #3a3a3a; }
                HorizontalLayout {
                    spacing: 8px;
                    height: 24px;
                    Text { text: "Proxy"; color: #f0f0f0; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: "Current: " + root.proxy-current;
                        color: #a8b8c8;
                        vertical-alignment: center;
                    }
                }
                // one-line rejection of a bad definition (drafts survive)
                Text {
                    visible: root.proxy-error != "";
                    text: root.proxy-error;
                    color: #ef5350;
                    wrap: word-wrap;
                }
                for p[i] in root.proxy-rows: Rectangle {
                    height: 26px;
                    width: parent.width;
                    // same z-order rule as the UA rows: background and the
                    // row-wide TouchArea are declared before the content, so
                    // the Del button (declared last) still gets its clicks.
                    pbg := Rectangle {
                        background: p.active ? #3a3a3a : pta.has-hover ? #2c2c2c : #262626;
                        border-radius: 4px;
                    }
                    pta := TouchArea {
                        clicked => { root.proxy-select(i); }
                    }
                    Text {
                        x: 10px;
                        max-width: parent.width - 80px;
                        height: parent.height;
                        text: p.name + (p.url != "" ? "  —  " + p.url : "") + (p.active ? "  ✓" : "");
                        color: p.active ? #f0f0f0 : #c8c8c8;
                        font-weight: p.active ? 600 : 400;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    MiniButton {
                        visible: p.url != "";
                        x: parent.width - 66px;
                        y: 1px;
                        label: "Del";
                        clicked => { root.proxy-delete(i); }
                    }
                }
                HorizontalLayout {
                    height: 28px;
                    spacing: 6px;
                    LineEdit {
                        horizontal-stretch: 2;
                        text <=> root.proxy-add-name;
                        placeholder-text: "name";
                    }
                    LineEdit {
                        horizontal-stretch: 3;
                        text <=> root.proxy-add-url;
                        placeholder-text: "socks5://host:1080";
                        accepted => { root.proxy-add(); }
                    }
                    MiniButton { label: "Add"; clicked => { root.proxy-add(); } }
                }
                Text {
                    text: "Proxies are defined once, globally, and picked per container above — the container of the tab on screen. The choice is stored on the container, sent to its live tabs, and used for that container's new tabs. Schemes: socks5://, socks5h://, http://, https:// — user:pass@ and :port allowed.";
                    color: #888888;
                    wrap: word-wrap;
                }
            }
        }
    }

    // ------------------------------------------------------------------------
    // Downloads overlay (task: file downloads)
    //
    // The fifth right-docked Rectangle — the same rectangle pattern as the
    // archive/UA/manager/history menus (never a PopupWindow: LinuxKMS has
    // none), opened by the ⬇ toolbar button or Ctrl-Shift-D and never stacked.
    // Rows are per tab process: what the tab on screen has filed. A row shows
    // its full path once the file is complete; while it is writing the row
    // counts what has landed. `Clear finished` is a list operation — files it
    // named stay on the disk.
    // ------------------------------------------------------------------------
    Rectangle {
        x: 0; y: 0;
        width: root.width; height: root.height;
        visible: root.download-menu-open;
        background: #00000099;
        download-scrim := TouchArea { clicked => { root.close-download-menu(); } }

        download-panel := Rectangle {
            TouchArea {} // swallow clicks over the panel
            x: root.width - self.width;
            width: Math.min(460px, root.width);
            height: root.height;
            background: #1e1e1e;

            VerticalLayout {
                padding: 12px;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 8px;
                    height: 26px;
                    Text { text: "\u{2B07} Downloads"; color: #f0f0f0; font-weight: 600; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    MiniButton { label: "×"; clicked => { root.close-download-menu(); } }
                }

                // one-line summary (folder receiving the files + rows this tab filed)
                Text {
                    text: root.download-status;
                    color: #a8b8c8;
                    wrap: word-wrap;
                }

                // one-line validation feedback (a rejected Apply keeps the draft)
                Text {
                    visible: root.download-error != "";
                    text: root.download-error;
                    color: #ef5350;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    height: 28px;
                    spacing: 6px;
                    LineEdit {
                        horizontal-stretch: 1;
                        text <=> root.download-dir-text;
                        placeholder-text: "download folder (default: ~/Downloads)";
                        accepted(t) => { root.download-apply-dir(t); }
                    }
                    MiniButton { label: "Apply"; clicked => { root.download-apply-dir(root.download-dir-text); } }
                }

                dl-list := ListView {
                    vertical-stretch: 1;
                    for di in root.downloads: Rectangle {
                        height: 46px;
                        width: parent.width;
                        VerticalLayout {
                            x: 6px; y: 2px;
                            width: parent.width - 12px;
                            spacing: 0px;
                            HorizontalLayout {
                                spacing: 6px;
                                height: 20px;
                                Text {
                                    text: di.name;
                                    color: #e8e8e8;
                                    font-weight: 600;
                                    horizontal-alignment: left;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: di.status;
                                    color: #7fb27f;
                                    font-size: 11px;
                                    horizontal-alignment: right;
                                }
                            }
                            Text {
                                text: di.sub;
                                color: #8a8a8a;
                                font-size: 11px;
                                horizontal-alignment: left;
                                overflow: elide;
                            }
                        }
                    }
                }

                if root.downloads.length == 0: Text {
                    text: "No downloads in this tab — a file a page offers lands here, and the status line says so even when the panel is shut.";
                    color: #888888;
                    wrap: word-wrap;
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    height: 28px;
                    spacing: 6px;
                    MiniButton { label: "Clear finished"; clicked => { root.download-clear-finished(); } }
                    Rectangle { horizontal-stretch: 1; }
                }

                Text {
                    text: "A download is not a navigation: the page stays put while its bytes land in the folder. Rows belong to the tab that filed them — closing the tab drops the rows, and a tab that dies mid-download leaves no partial file behind. Ctrl-Shift-D opens and shuts this panel.";
                    color: #888888;
                    wrap: word-wrap;
                }
            }
        }
    }

    // ------------------------------------------------------------------
    // "Save page" dialog (task: save-page selector)
    // ------------------------------------------------------------------
    // Ctrl-S docks this over the page, on the same right side as every other
    // overlay and never stacked with one: two fields — the folder it saves
    // into (default ~/Downloads) and the name it saves under — and their
    // buttons. The write itself belongs to the tab and runs through the
    // download machinery; the ⬇ panel shows the result. The dialog only ever
    // picks the where and the what.
    Rectangle {
        x: 0; y: 0;
        width: root.width; height: root.height;
        visible: root.save-menu-open;
        background: #00000099;
        save-scrim := TouchArea { clicked => { root.close-save-menu(); } }

        save-panel := Rectangle {
            TouchArea {} // swallow clicks on the panel
            x: root.width - self.width;
            width: Math.min(460px, root.width);
            height: root.height;
            background: #1e1e1e;

            VerticalLayout {
                padding: 12px;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 8px;
                    height: 26px;
                    Text { text: "\u{1F4BE} Save page"; color: #f0f0f0; font-weight: 600; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    MiniButton { label: "\u{2715}"; clicked => { root.close-save-menu(); } }
                }

                // Which page this save is about, spelled out.
                Text {
                    text: root.save-page;
                    color: #a8b8c8;
                    wrap: word-wrap;
                }

                Text {
                    visible: root.save-error != "";
                    text: root.save-error;
                    color: #ef5350;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    height: 28px;
                    spacing: 6px;
                    LineEdit {
                        horizontal-stretch: 1;
                        text <=> root.save-dir-text;
                        placeholder-text: "save folder (default: ~/Downloads)";
                        accepted(t) => { root.save-pick-folder(t); }
                    }
                    MiniButton { label: "Choose \u{1F4C1}"; clicked => { root.save-pick-folder(root.save-dir-text); } }
                }

                HorizontalLayout {
                    height: 28px;
                    spacing: 6px;
                    LineEdit {
                        horizontal-stretch: 1;
                        text <=> root.save-name-text;
                        placeholder-text: "file name";
                        accepted(t) => { root.save-page-confirm(t); }
                    }
                    MiniButton { label: "Save"; clicked => { root.save-page-confirm(root.save-name-text); } }
                }

                Rectangle { vertical-stretch: 1; }

                Text {
                    text: "The folder follows the ⬇ panel's rules: absolute (or ~/…), and it is created when accepted. Point it, confirm the name with Save or Enter, and the page is fetched into that folder under that name and shows up in the ⬇ list — which opens with Ctrl-Shift-D. Esc, or a click outside, closes the dialog without saving.";
                    color: #888888;
                    wrap: word-wrap;
                }
            }
        }
    }

    // ------------------------------------------------------------------
    // URL bar autocomplete dropdown (task: URL bar autocomplete)
    // ------------------------------------------------------------------
    // Floats directly under the address bar, the same width, listing the
    // ranked visits Rust keeps in `suggest-items` (≤ 8 rows) while the draft
    // matches them and the entry still has focus — clicking away into the
    // page or a menu hides it even before Rust clears `suggest-open`. The
    // highlighted row takes the same accent the tab strip uses; a click on a
    // row is a pick (Rust navigates and closes), and ↑/↓/Enter/Esc reach the
    // panel through the entry itself (see `UrlBar`).
    Rectangle {
        visible: root.suggest-open && root.suggest-items.length > 0 && url-bar.edit-focus;
        x: url-bar.absolute-position.x;
        y: url-bar.absolute-position.y + url-bar.height;
        width: url-bar.width;
        height: root.suggest-items.length * 30px + 10px;
        background: #262626f2;
        border-radius: 6px;
        border-width: 1px;
        border-color: #3d3d3d;

        VerticalLayout {
            x: 5px;
            width: parent.width - 10px;
            y: 5px;
            height: parent.height - 10px;
            spacing: 0px;

            for s[i] in root.suggest-items: Rectangle {
                height: 30px;
                background: root.suggest-selected == i ? #3a3a3a : (scta.has-hover ? #313131 : transparent);
                scta := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.suggest-pick(i); }
                }
                sgt := Text {
                    x: 8px;
                    width: parent.width - 16px;
                    y: 2px;
                    height: 15px;
                    text: s.title;
                    color: root.suggest-selected == i ? #f0f0f0 : #cfcfcf;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                sgu := Text {
                    x: 8px;
                    width: parent.width - 16px;
                    y: 16px;
                    height: 13px;
                    text: s.url;
                    color: #8a8a8a;
                    font-size: 10px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }

    // ------------------------------------------------------------------
    // Hover tooltip (task: popup blocker tooltip)
    // ------------------------------------------------------------------
    // Declared last ⇒ in front of the page, the DevTools panel and every other
    // overlay; it hangs below the control the pointer is on (`tip-x`/`tip-y`,
    // reported by that control) and pulls itself back from the right edge so a
    // button near the end of the toolbar does not push its own words off the
    // screen. Nothing here takes the pointer — no `TouchArea` — so the tooltip
    // never eats the hover it is drawn from, and it disappears the moment the
    // pointer leaves the control it came from.
    tip-layer := Rectangle {
        visible: root.tip-on && (root.tip-text != "" || root.popup-tip != "");
        x: Math.min(root.tip-x, parent.width - self.width - 8px);
        y: root.tip-y;
        // A whole page title is longer than a toolbar word and can outgrow the
        // window: the box stops at its edges and the words are elided there
        // rather than drawn off-screen.
        width: Math.min(tip-lbl.preferred-width + 16px, parent.width - 16px);
        height: tip-lbl.preferred-height + 10px;
        background: #1b1b1bf7;
        border-radius: 4px;
        border-width: 1px;
        border-color: #4a4a4a;

        tip-lbl := Text {
            x: 8px;
            y: 5px;
            width: parent.width - 16px;
            overflow: elide;
            text: root.tip-text != "" ? root.tip-text : root.popup-tip;
            color: #e0e0e0;
            font-size: 11px;
        }
    }
}
